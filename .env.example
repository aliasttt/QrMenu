DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# reCAPTCHA (signup anti-bot) — get keys at https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=6LegqYosAAAAAAju_TldSXiCWiSp0OxYmI_WW1D2
RECAPTCHA_SECRET_KEY=6LegqYosAAAAAIYI72wXuc2zp6i64xn05wgYxCCg

# Stripe (use test keys for development)
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_ANNUAL=price_xxx

# Apple App Store Server API (do not commit real private keys)
# IMPORTANT: The key below MUST be an "In-App Purchase" key from
# App Store Connect → Users & Access → Integrations → In-App Purchase tab.
# The "App Store Connect API" key on the sibling tab looks similar but
# is rejected by the App Store Server API with HTTP 401.
# ISSUER_ID must be the value shown on the same In-App Purchase page as the key,
# and must NOT include the "Issuer ID:" label prefix (only the UUID itself).
APPLE_APP_STORE_ISSUER_ID=00000000-0000-0000-0000-000000000000
APPLE_APP_STORE_KEY_ID=XXXXXXXXXX
# Paste the full .p8 contents including the BEGIN/END lines. When storing this
# in a single-line env var, keep real newlines OR use literal \n — both are
# normalised on the server side.
APPLE_APP_STORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_P8_CONTENT_HERE\n-----END PRIVATE KEY-----"
# Must match the bundle identifier registered for the In-App Purchase key above
# (Xcode → Target → Signing & Capabilities → Bundle Identifier). The iOS client
# sends this bundleId inside the signed transaction JWS; mismatch = rejection.
APPLE_APP_BUNDLE_ID=com.qrmenu.new
APPLE_SUBSCRIPTION_PRODUCT_IDS=de.preismenu.monthly,de.preismenu.yearly
APPLE_APP_STORE_PRODUCTION_URL=https://api.storekit.itunes.apple.com
APPLE_APP_STORE_SANDBOX_URL=https://api.storekit-sandbox.itunes.apple.com
APPLE_ROOT_CERTIFICATES_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Google Play subscriptions (use real values from Play Console / Google Cloud).
GOOGLE_PLAY_PACKAGE_NAME=com.example.preismenu
# Exact JSON schema: product ID -> list of allowed base plan IDs. Replace every placeholder.
GOOGLE_PLAY_SUBSCRIPTION_PRODUCTS_JSON={"YOUR_PRODUCT_ID":["YOUR_BASE_PLAN_ID"]}
# Base64 is transport encoding, not encryption. Store only in Scalingo env; use ADC when available.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_B64=
# Generate once with Fernet.generate_key(); changing it makes stored purchase tokens unreadable.
GOOGLE_PLAY_TOKEN_ENCRYPTION_KEY=
# Exact OIDC audience and push-auth service-account email configured on the Pub/Sub subscription.
GOOGLE_PUBSUB_AUDIENCE=https://preismenu.de/api/business-menu/admin/subscriptions/google/notifications/
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=pubsub-push@YOUR_GCP_PROJECT.iam.gserviceaccount.com

# Sandbox/test purchases entitle only in explicitly opted-in environments.
ALLOW_TEST_SUBSCRIPTION_ENTITLEMENTS=True
# Temporary compatibility switch; disable only after backfill and reconciliation.
LEGACY_SUBSCRIPTION_FALLBACK_ENABLED=True

# App download links (panel + public)
APP_ANDROID_URL=https://example.com/app.apk
APP_IOS_URL=https://apps.apple.com/app/id000000000
# Browser key; restrict by HTTP referrer (preismenu.de) in Google Cloud Console
GOOGLE_MAPS_API_KEY=

# Email / cache safety
EMAIL_HOST=smtp.titan.email
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=qrmenu@mybonusberlin.com
BONUS_FROM_EMAIL=qrmenu@mybonusberlin.com
CONTACT_ADMIN_EMAIL=qrmenu@mybonusberlin.com
REDIS_URL=
EMAIL_LIMIT_REGISTRATION_PER_EMAIL_15M=3
EMAIL_LIMIT_REGISTRATION_PER_IP_1H=10
EMAIL_LIMIT_PASSWORD_RESET_PER_EMAIL_30M=3
EMAIL_LIMIT_PASSWORD_RESET_PER_IP_1H=10
EMAIL_LIMIT_CONTACT_PER_IP_10M=5
EMAIL_LIMIT_CONTACT_PER_EMAIL_1H=3
EMAIL_GLOBAL_SAFETY_LIMIT=200
EMAIL_GLOBAL_SAFETY_WINDOW_SECONDS=3600
EMAIL_ACTION_COOLDOWN_SECONDS=60
EMAIL_TASK_LOCK_SECONDS=600

# Cloudflare Turnstile (public browser forms)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
