msgstr "Menünüzü birden fazla dilde sunun ve müşteriler dili anında değiştirsin."

#: .\core\views.py:276
msgid "Better guest experience for tourists"
msgstr "Turistler için daha iyi deneyim"

#: .\core\views.py:277
