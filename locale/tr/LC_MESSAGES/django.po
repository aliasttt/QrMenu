msgstr "Basit bir panelden kategoriler oluşturun, yemek fotoğrafları ekleyin, fiyat belirleyin ve öğeleri yeniden sıralayın."

#: .\core\views.py:252
msgid "Unlimited menu items"
msgstr "Sınırsız menü öğesi"

#: .\core\views.py:253
msgid "Quick editing for daily changes"
msgstr "Günlük değişiklikler için hızlı düzenleme"

#: .\core\views.py:254
msgid "Clear structure for better ordering"
msgstr "Daha iyi sipariş için net yapı"

