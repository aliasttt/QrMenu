#: .\core\views.py:106
msgid "Owner, Basil House"
msgstr "Sahibi, Basil House"

#: .\core\views.py:106
msgid "We increased table turnover with faster ordering."
msgstr "Daha hızlı siparişle masa devir hızını artırdık."

#: .\core\views.py:107
msgid "Manager, South Fork"
msgstr "Müdür, South Fork"

#: .\core\views.py:107
msgid "Campaigns helped us fill off-peak hours."
msgstr "Kampanyalar, yoğun olmayan saatleri doldurmamıza yardımcı oldu."

#: .\core\views.py:108
msgid "Founder, Luna Cafe"
msgstr "Kurucu, Luna Cafe"

#: .\core\views.py:108
msgid "Our staff now spends less time taking manual orders."
msgstr "Personelimiz artık manuel sipariş almak için daha az zaman harcıyor."

#: .\core\views.py:111 .\core\views.py:133
msgid "AI menu import"
msgstr "AI menü içe aktarma"

#: .\core\views.py:112 .\core\views.py:134
msgid "Multilingual menus"
msgstr "Çok dilli menüler"

#: .\core\views.py:113 .\core\views.py:135
msgid "QR code generation"
msgstr "QR kod oluşturma"

#: .\core\views.py:114 .\core\views.py:136
msgid "Order management"
msgstr "Sipariş yönetimi"

#: .\core\views.py:115 .\core\views.py:137
msgid "Campaign engine"
msgstr "Kampanya motoru"

#: .\core\views.py:116 .\core\views.py:138
msgid "Daily analytics"
msgstr "Günlük analitik"

#: .\core\views.py:117 .\core\views.py:139
msgid "Category controls"
msgstr "Kategori kontrolleri"

#: .\core\views.py:118 .\core\views.py:140
msgid "Live availability"
msgstr "Canlı stok durumu"

#: .\core\views.py:119 .\core\views.py:141
msgid "POS-ready payloads"
msgstr "POS uyumlu veri paketleri"

#: .\core\views.py:120 .\core\views.py:142
msgid "Mobile-first pages"
msgstr "Mobil öncelikli sayfalar"

#: .\core\views.py:121 .\core\views.py:143
msgid "Role-ready panel"
msgstr "Rol destekli panel"

#: .\core\views.py:122 .\core\views.py:144
msgid "Conversion focused UI"
msgstr "Dönüşüm odaklı arayüz"

#: .\core\views.py:133
msgid ""
"Upload a PDF or photo and we extract your dishes and prices automatically."
msgstr "Bir PDF veya fotoğraf yükleyin, yemekleri ve fiyatları otomatik olarak çıkaralım."

#: .\core\views.py:134
msgid ""
"Serve your menu in multiple languages and switch by customer preference."
msgstr "Menünüzü birden fazla dilde sunun ve müşteri tercihine göre değiştirin."

#: .\core\views.py:135
msgid "Generate and download QR codes for tables, takeaway, and delivery."
msgstr "Masalar, gel-al ve teslimat için QR kodları oluşturun ve indirin."

#: .\core\views.py:136
msgid ""
"Receive, track, and fulfill orders from one dashboard with status updates."
msgstr "Siparişleri tek panelden alın, takip edin ve durum güncellemeleriyle tamamlayın."

#: .\core\views.py:137
msgid ""
"Create time-based discounts, happy hours, and target specific categories."
msgstr "Zamana bağlı indirimler, happy hour ve belirli kategorileri hedefleyin."

#: .\core\views.py:138
msgid "View orders, revenue, and top items with simple charts and exports."
msgstr "Basit grafikler ve dışa aktarmalarla sipariş, gelir ve en iyi ürünleri görün."

#: .\core\views.py:139
msgid "Organize items into categories and reorder with drag-and-drop."
msgstr "Öğeleri kategorilere ayırın ve sürükle-bırak ile yeniden sıralayın."

#: .\core\views.py:140
msgid "Mark items as out of stock and hide or show sections by schedule."
msgstr "Ürünleri stok dışı olarak işaretleyin ve bölümleri zamana göre gizleyin/gösterin."

#: .\core\views.py:141
msgid "Send orders to your POS or kitchen display via webhooks or API."
msgstr "Siparişleri webhook veya API ile POS'a veya mutfak ekranına gönderin."

#: .\core\views.py:142
msgid "Menus and checkout are optimized for phones and tablets."
msgstr "Menüler ve ödeme, telefon ve tabletler için optimize edildi."

#: .\core\views.py:143
msgid "Invite staff with roles: admin, manager, or view-only."
msgstr "Personeli rollerle davet edin: admin, yönetici veya sadece görüntüleme."

#: .\core\views.py:144
msgid "Clean design and clear CTAs to maximize add-to-cart and checkout."
msgstr "Sepete ekleme ve ödemeyi en üst düzeye çıkaran temiz tasarım ve net CTA'lar."

#: .\core\views.py:147
msgid "Can I use my own domain?"
msgstr "Kendi alan adımı kullanabilir miyim?"

#: .\core\views.py:147
msgid ""
"Yes. You can connect a custom domain (e.g. menu.yourrestaurant.com) from the "
"settings panel."
msgstr "Evet. Ayarlar panelinden özel bir alan adı (örn. menu.restoranınız.com) bağlayabilirsiniz."

#: .\core\views.py:148
msgid "Is there a mobile app for staff?"
msgstr "Personel için mobil uygulama var mı?"

#: .\core\views.py:148
msgid ""
"The panel is fully responsive; you can use it from any browser. Native apps "
"are on our roadmap."
msgstr "Panel tamamen duyarlıdır ve herhangi bir tarayıcıdan kullanılabilir. Yerel uygulamalar yol haritamızda."

#: .\core\views.py:149
msgid "How do I print QR codes?"
msgstr "QR kodları nasıl basarım?"

#: .\core\views.py:149
msgid ""
"Generate QR codes from the dashboard and download as PNG or SVG. Print on "
"table tents or stickers."
msgstr "Panelden QR kodları oluşturun ve PNG veya SVG olarak indirin. Masa dikmelerine veya çıkartmalara basın."

#: .\core\views.py:150
msgid "Do you integrate with POS?"
msgstr "POS ile entegre olur mu?"

#: .\core\views.py:150
msgid ""
"We support webhooks and an API so you can push orders to your POS or kitchen "
"display system."
msgstr "Siparişleri POS veya mutfak ekranınıza göndermeniz için webhook ve API desteği sunuyoruz."

#: .\core\views.py:157
msgid "Set up your menu"
msgstr "Menünüzü kurun"

#: .\core\views.py:157
msgid ""
"Create categories, add dishes with prices and photos, and set availability."
msgstr "Kategoriler oluşturun, fiyat ve fotoğraflarla yemekler ekleyin ve stok durumu ayarlayın."

#: .\core\views.py:157
msgid "Drag-and-drop reorder, bulk edit, or import from spreadsheet."
msgstr "Sürükle-bırak ile sıralayın, toplu düzenleyin veya elektronik tablodan içe aktarın."

#: .\core\views.py:158
msgid "Generate your QR"
msgstr "QR kodunuzu oluşturun"

#: .\core\views.py:158
msgid ""
"Print QR codes for each table or area. Customers scan to open your menu."
msgstr "Her masa veya alan için QR kodları basın. Müşteriler tarayarak menünüzü açar."

#: .\core\views.py:158
msgid "Download PNG or SVG, print on table tents or stickers."
msgstr "PNG veya SVG olarak indirin, masa dikmelerine veya çıkartmalara basın."

#: .\core\views.py:159
msgid "Get online orders"
msgstr "Online sipariş alın"

#: .\core\views.py:159
msgid ""
"Customers browse, add to cart, and checkout. You receive and fulfill orders."
msgstr "Müşteriler menüye göz atar, sepete ekler ve öder. Siz siparişleri alır ve hazırlarsınız."

#: .\core\views.py:159
msgid "Optional: connect to POS or kitchen display."
msgstr "İsteğe bağlı: POS veya mutfak ekranına bağlanın."

#: .\core\views.py:170
msgid "QR menu — customers scan and browse your menu on their phone"
msgstr "QR menü — müşteriler telefonlarından tarayıp menünüze göz atar."

#: .\core\views.py:171
msgid "Unlimited menu items and categories"
msgstr "Sınırsız menü öğesi ve kategori"

#: .\core\views.py:172
msgid "Unlimited QR codes for tables and takeaway"
msgstr "Masalar ve gel-al için sınırsız QR kod"

#: .\core\views.py:173
msgid "Online ordering — guests order and pay from the same link"
msgstr "Online sipariş — misafirler aynı bağlantıdan sipariş verir ve öder."

#: .\core\views.py:174
msgid "Customizable themes to match your brand"
msgstr "Markanıza uygun özelleştirilebilir temalar"

#: .\core\views.py:175
msgid "Campaigns & discounts (happy hour, daily specials)"
msgstr "Kampanyalar ve indirimler (happy hour, günün fırsatları)"

#: .\core\views.py:176
msgid "Multilingual menu support"
msgstr "Çok dilli menü desteği"

#: .\core\views.py:177
msgid "Real-time updates — change prices and availability instantly"
msgstr "Gerçek zamanlı güncellemeler — fiyat ve stok anında değişir."

#: .\core\views.py:178
msgid "Basic analytics — see what sells"
msgstr "Temel analitik — neyin sattığını görün."

#: .\core\views.py:179
msgid "Email & WhatsApp support"
msgstr "E-posta ve WhatsApp desteği"

#: .\core\views.py:183
msgid "Win more orders"
msgstr "Daha fazla sipariş kazanın"

#: .\core\views.py:183
msgid ""
"Guests order directly from the QR menu. No waiting for staff—faster turnover "
"and higher revenue."
msgstr "Misafirler doğrudan QR menüden sipariş verir. Personel beklemek yok — daha hızlı devir, daha fazla gelir."

#: .\core\views.py:184
msgid "Look professional"
msgstr "Profesyonel görün"

#: .\core\views.py:184
msgid ""
"A clean digital menu and your own domain build trust. Stand out from "
"competitors still using paper."
msgstr "Temiz dijital menü ve kendi alan adınız güven verir. Hâlâ kağıt kullanan rakiplerden sıyrılın."

#: .\core\views.py:185
msgid "One subscription, everything included"
msgstr "Tek abonelik, her şey dahil"

#: .\core\views.py:185
msgid ""
"No per-order fees or hidden costs. One annual fee covers menu, ordering, and "
"support."
msgstr "Sipariş başına ücret veya gizli maliyet yok. Yıllık tek ücret menü, sipariş ve desteği kapsar."

#: .\core\views.py:186
msgid "Launch in minutes"
msgstr "Dakikalar içinde yayına alın"

#: .\core\views.py:186
msgid ""
"Add your dishes, print a QR code, and go live. No IT or design skills needed."
msgstr "Yemekleri ekleyin, QR kodu basın ve yayına alın. BT veya tasarım bilgisine gerek yok."

#: .\core\views.py:189
msgid "What is included in the price?"
msgstr "Fiyata neler dahil?"

#: .\core\views.py:189
msgid ""
"Everything: QR menu, online ordering, unlimited items and QR codes, "
"campaigns, custom domain option, themes, and support. One annual "
"subscription, no per-order fees."
msgstr "Her şey: QR menü, online sipariş, sınırsız öğe ve QR kod, kampanyalar, özel alan adı seçeneği, temalar ve destek. Yıllık tek abonelik, sipariş başı ücret yok."

#: .\core\views.py:190
msgid "Is there a free trial?"
msgstr "Ücretsiz deneme var mı?"

#: .\core\views.py:190
msgid ""
"Yes. Start with a free trial to build your menu and test ordering. No card "
"required until you go live."
msgstr "Evet. Menünüzü oluşturmak ve siparişi test etmek için ücretsiz denemeyle başlayın. Yayına alana kadar kart gerekmez."

#: .\core\views.py:191
msgid "Why 19% VAT?"
msgstr "Neden %19 KDV?"

#: .\core\views.py:191
#, python-format
msgid ""
"We are VAT-registered in the EU. If you are in the EU and liable for VAT, "
"19% is added at checkout (total €238/year). If you are outside the EU or VAT-"
"exempt, the amount may differ."
msgstr "AB'de KDV mükellefiyiz. AB'deyseniz ve KDV'ye tabiyseniz ödemeye %19 eklenir (yıllık toplam €238). AB dışıysanız veya KDV muafiyeti varsa tutar farklı olabilir."

