#: .\core\views.py:122
msgid "Owner, Basil House"
msgstr "Sahibi, Basil House"

#: .\core\views.py:122
msgid "We increased table turnover with faster ordering."
msgstr "Daha hızlı siparişle masa devir hızını artırdık."

#: .\core\views.py:123
msgid "Manager, South Fork"
msgstr "Müdür, South Fork"

#: .\core\views.py:123
msgid "Campaigns helped us fill off-peak hours."
msgstr "Kampanyalar, yoğun olmayan saatleri doldurmamıza yardımcı oldu."

#: .\core\views.py:124
msgid "Founder, Luna Cafe"
msgstr "Kurucu, Luna Cafe"

#: .\core\views.py:124
msgid "Our staff now spends less time taking manual orders."
msgstr "Personelimiz artık manuel sipariş almak için daha az zaman harcıyor."

#: .\core\views.py:127 .\core\views.py:149
msgid "AI menu import"
msgstr "AI menü içe aktarma"

#: .\core\views.py:128 .\core\views.py:150
msgid "Multilingual menus"
msgstr "Çok dilli menüler"

#: .\core\views.py:129 .\core\views.py:151
msgid "QR code generation"
msgstr "QR kod oluşturma"

#: .\core\views.py:130 .\core\views.py:152
msgid "Order management"
msgstr "Sipariş yönetimi"

#: .\core\views.py:131 .\core\views.py:153
msgid "Campaign engine"
msgstr "Kampanya motoru"

#: .\core\views.py:132 .\core\views.py:154
msgid "Daily analytics"
msgstr "Günlük analitik"

#: .\core\views.py:133 .\core\views.py:155
msgid "Category controls"
msgstr "Kategori kontrolleri"

#: .\core\views.py:134 .\core\views.py:156
msgid "Live availability"
msgstr "Canlı stok durumu"

#: .\core\views.py:135 .\core\views.py:157
msgid "POS-ready payloads"
msgstr "POS uyumlu veri paketleri"

#: .\core\views.py:136 .\core\views.py:158
msgid "Mobile-first pages"
msgstr "Mobil öncelikli sayfalar"

#: .\core\views.py:137 .\core\views.py:159
msgid "Role-ready panel"
msgstr "Rol destekli panel"

#: .\core\views.py:138 .\core\views.py:160
msgid "Conversion focused UI"
msgstr "Dönüşüm odaklı arayüz"

#: .\core\views.py:149
msgid ""
"Upload a PDF or photo and we extract your dishes and prices automatically."
msgstr ""
"Bir PDF veya fotoğraf yükleyin, yemekleri ve fiyatları otomatik olarak "
"çıkaralım."

#: .\core\views.py:150
msgid ""
"Serve your menu in multiple languages and switch by customer preference."
msgstr ""
"Menünüzü birden fazla dilde sunun ve müşteri tercihine göre değiştirin."

#: .\core\views.py:151
msgid "Generate and download QR codes for tables, takeaway, and delivery."
msgstr "Masalar, gel-al ve teslimat için QR kodları oluşturun ve indirin."

#: .\core\views.py:152
msgid ""
"Receive, track, and fulfill orders from one dashboard with status updates."
msgstr ""
"Siparişleri tek panelden alın, takip edin ve durum güncellemeleriyle "
"tamamlayın."

#: .\core\views.py:153
msgid ""
"Create time-based discounts, happy hours, and target specific categories."
msgstr ""
"Zamana bağlı indirimler, happy hour ve belirli kategorileri hedefleyin."

#: .\core\views.py:154
msgid "View orders, revenue, and top items with simple charts and exports."
msgstr ""
"Basit grafikler ve dışa aktarmalarla sipariş, gelir ve en iyi ürünleri "
"görün."

#: .\core\views.py:155
msgid "Organize items into categories and reorder with drag-and-drop."
msgstr "Öğeleri kategorilere ayırın ve sürükle-bırak ile yeniden sıralayın."

#: .\core\views.py:156
msgid "Mark items as out of stock and hide or show sections by schedule."
msgstr ""
"Ürünleri stok dışı olarak işaretleyin ve bölümleri zamana göre "
"gizleyin/gösterin."

#: .\core\views.py:157
msgid "Send orders to your POS or kitchen display via webhooks or API."
msgstr "Siparişleri webhook veya API ile POS'a veya mutfak ekranına gönderin."

#: .\core\views.py:158
msgid "Menus and checkout are optimized for phones and tablets."
msgstr "Menüler ve ödeme, telefon ve tabletler için optimize edildi."

#: .\core\views.py:159
msgid "Invite staff with roles: admin, manager, or view-only."
msgstr ""
"Personeli rollerle davet edin: admin, yönetici veya sadece görüntüleme."

#: .\core\views.py:160
msgid "Clean design and clear CTAs to maximize add-to-cart and checkout."
msgstr ""
"Sepete ekleme ve ödemeyi en üst düzeye çıkaran temiz tasarım ve net CTA'lar."

#: .\core\views.py:163
msgid "Can I use my own domain?"
msgstr "Kendi alan adımı kullanabilir miyim?"

#: .\core\views.py:163
msgid ""
"Yes. You can connect a custom domain (e.g. menu.yourrestaurant.com) from the"
" settings panel."
msgstr ""
"Evet. Ayarlar panelinden özel bir alan adı (örn. menu.restoranınız.com) "
"bağlayabilirsiniz."

#: .\core\views.py:164
msgid "Is there a mobile app for staff?"
msgstr "Personel için mobil uygulama var mı?"

#: .\core\views.py:164
msgid ""
"The panel is fully responsive; you can use it from any browser. Native apps "
"are on our roadmap."
msgstr ""
"Panel tamamen duyarlıdır ve herhangi bir tarayıcıdan kullanılabilir. Yerel "
"uygulamalar yol haritamızda."

#: .\core\views.py:165
msgid "How do I print QR codes?"
msgstr "QR kodları nasıl basarım?"

#: .\core\views.py:165
msgid ""
"Generate QR codes from the dashboard and download as PNG or SVG. Print on "
"table tents or stickers."
msgstr ""
"Panelden QR kodları oluşturun ve PNG veya SVG olarak indirin. Masa "
"dikmelerine veya çıkartmalara basın."

#: .\core\views.py:166
msgid "Do you integrate with POS?"
msgstr "POS ile entegre olur mu?"

#: .\core\views.py:166
msgid ""
"We support webhooks and an API so you can push orders to your POS or kitchen"
" display system."
msgstr ""
"Siparişleri POS veya mutfak ekranınıza göndermeniz için webhook ve API "
"desteği sunuyoruz."

#: .\core\views.py:173
msgid "Set up your menu"
msgstr "Menünüzü kurun"

#: .\core\views.py:173
msgid ""
"Create categories, add dishes with prices and photos, and set availability."
msgstr ""
"Kategoriler oluşturun, fiyat ve fotoğraflarla yemekler ekleyin ve stok "
"durumu ayarlayın."

#: .\core\views.py:173
msgid "Drag-and-drop reorder, bulk edit, or import from spreadsheet."
msgstr ""
"Sürükle-bırak ile sıralayın, toplu düzenleyin veya elektronik tablodan içe "
"aktarın."

#: .\core\views.py:174
msgid "Generate your QR"
msgstr "QR kodunuzu oluşturun"

#: .\core\views.py:174
msgid ""
"Print QR codes for each table or area. Customers scan to open your menu."
msgstr ""
"Her masa veya alan için QR kodları basın. Müşteriler tarayarak menünüzü "
"açar."

#: .\core\views.py:174
msgid "Download PNG or SVG, print on table tents or stickers."
msgstr ""
"PNG veya SVG olarak indirin, masa dikmelerine veya çıkartmalara basın."

#: .\core\views.py:175
msgid "Get online orders"
msgstr "Online sipariş alın"

#: .\core\views.py:175
msgid ""
"Customers browse, add to cart, and checkout. You receive and fulfill orders."
msgstr ""
"Müşteriler menüye göz atar, sepete ekler ve öder. Siz siparişleri alır ve "
"hazırlarsınız."

#: .\core\views.py:175
msgid "Optional: connect to POS or kitchen display."
msgstr "İsteğe bağlı: POS veya mutfak ekranına bağlanın."

#: .\core\views.py:186
msgid "QR menu — customers scan and browse your menu on their phone"
msgstr "QR menü — müşteriler telefonlarından tarayıp menünüze göz atar."

#: .\core\views.py:187
msgid "Unlimited menu items and categories"
msgstr "Sınırsız menü öğesi ve kategori"

#: .\core\views.py:188
msgid "Unlimited QR codes for tables and takeaway"
msgstr "Masalar ve gel-al için sınırsız QR kod"

#: .\core\views.py:189
msgid "Online ordering — guests order and pay from the same link"
msgstr "Online sipariş — misafirler aynı bağlantıdan sipariş verir ve öder."

#: .\core\views.py:190
msgid "Customizable themes to match your brand"
msgstr "Markanıza uygun özelleştirilebilir temalar"

#: .\core\views.py:191
msgid "Campaigns & discounts (happy hour, daily specials)"
msgstr "Kampanyalar ve indirimler (happy hour, günün fırsatları)"

#: .\core\views.py:192
msgid "Multilingual menu support"
msgstr "Çok dilli menü desteği"

#: .\core\views.py:193
msgid "Real-time updates — change prices and availability instantly"
msgstr "Gerçek zamanlı güncellemeler — fiyat ve stok anında değişir."

#: .\core\views.py:194
msgid "Basic analytics — see what sells"
msgstr "Temel analitik — neyin sattığını görün."

#: .\core\views.py:195
msgid "Email & WhatsApp support"
msgstr "E-posta ve WhatsApp desteği"

#: .\core\views.py:199
msgid "Win more orders"
msgstr "Daha fazla sipariş kazanın"

#: .\core\views.py:199
msgid ""
"Guests order directly from the QR menu. No waiting for staff—faster turnover"
" and higher revenue."
msgstr ""
"Misafirler doğrudan QR menüden sipariş verir. Personel beklemek yok — daha "
"hızlı devir, daha fazla gelir."

#: .\core\views.py:200
msgid "Look professional"
msgstr "Profesyonel görün"

#: .\core\views.py:200
msgid ""
"A clean digital menu and your own domain build trust. Stand out from "
"competitors still using paper."
msgstr ""
"Temiz dijital menü ve kendi alan adınız güven verir. Hâlâ kağıt kullanan "
"rakiplerden sıyrılın."

#: .\core\views.py:201
msgid "One subscription, everything included"
msgstr "Tek abonelik, her şey dahil"

#: .\core\views.py:201
msgid ""
"No per-order fees or hidden costs. One annual fee covers menu, ordering, and"
" support."
msgstr ""
"Sipariş başına ücret veya gizli maliyet yok. Yıllık tek ücret menü, sipariş "
"ve desteği kapsar."

#: .\core\views.py:202
msgid "Launch in minutes"
msgstr "Dakikalar içinde yayına alın"

#: .\core\views.py:202
msgid ""
"Add your dishes, print a QR code, and go live. No IT or design skills "
"needed."
msgstr ""
"Yemekleri ekleyin, QR kodu basın ve yayına alın. BT veya tasarım bilgisine "
"gerek yok."

#: .\core\views.py:205
msgid "What is included in the price?"
msgstr "Fiyata neler dahil?"

#: .\core\views.py:205
msgid ""
"Everything: QR menu, online ordering, unlimited items and QR codes, "
"campaigns, custom domain option, themes, and support. One annual "
"subscription, no per-order fees."
msgstr ""
"Her şey: QR menü, online sipariş, sınırsız öğe ve QR kod, kampanyalar, özel "
"alan adı seçeneği, temalar ve destek. Yıllık tek abonelik, sipariş başı "
"ücret yok."

#: .\core\views.py:206
msgid "Is there a free trial?"
msgstr "Ücretsiz deneme var mı?"

#: .\core\views.py:206
msgid ""
"Yes. Start with a free trial to build your menu and test ordering. No card "
"required until you go live."
msgstr ""
"Evet. Menünüzü oluşturmak ve siparişi test etmek için ücretsiz denemeyle "
"başlayın. Yayına alana kadar kart gerekmez."

#: .\core\views.py:207
msgid "Why 19% VAT?"
msgstr "Neden %19 KDV?"

#: .\core\views.py:207
msgid ""
"We are VAT-registered in the EU. If you are in the EU and liable for VAT, a "
"19 percent VAT charge is added at checkout (total €238/year). If you are "
"outside the EU or VAT-exempt, the amount may differ."
msgstr ""
"AB'de KDV mükellefiyiz. AB'deyseniz ve KDV'ye tabiyseniz ödemeye %19 eklenir"
" (yıllık toplam €238). AB dışıysanız veya KDV muafiyeti varsa tutar farklı "
"olabilir."

#: .\core\views.py:244
msgid "Security check failed. Please reload the page and try again."
msgstr ""
"Güvenlik kontrolü başarısız oldu. Lütfen sayfayı yeniden yükleyin ve tekrar "
"deneyin."

#: .\core\views.py:247 .\core\views.py:291
msgid "Thanks. If your message needs a reply, we will contact you."
msgstr ""
"Teşekkürler. Mesajınızın bir cevabı gerekiyorsa, sizinle iletişime "
"geçeceğiz."

#: .\core\views.py:250
msgid "Security check failed. Please try again."
msgstr "Güvenlik kontrolü başarısız oldu. Lütfen tekrar deneyin."

#: .\core\views.py:259
msgid "Please check the form fields and try again."
msgstr "Lütfen form alanlarını kontrol edin ve tekrar deneyin."

#: .\core\views.py:262
msgid "Please complete all fields."
msgstr "Lütfen tüm alanları tamamlamak."

#: .\core\views.py:267
msgid "Too many messages. Please try again later."
msgstr "Çok fazla mesaj. Lütfen daha sonra tekrar deneyin."

#: .\core\views.py:270
msgid "Please wait before sending another message."
msgstr "Lütfen başka bir mesaj göndermeden önce bekleyin."

#: .\core\views.py:298 .\templates\partials\navbar.html:47
msgid "AI Menu Import"
msgstr "AI Menü İçe Aktarma"

#: .\core\views.py:299
msgid "Turn paper menus into digital menus in minutes."
msgstr "Kağıt menüleri dakikalar içinde dijitale çevirin."

#: .\core\views.py:300
msgid ""
"Upload a photo or PDF and let AI extract dish names, descriptions, and "
"prices automatically."
msgstr ""
"Bir fotoğraf veya PDF yükleyin; AI, yemek adlarını, açıklamaları ve "
"fiyatları otomatik olarak çıkarır."

#: .\core\views.py:303
msgid "Save hours of manual typing"
msgstr "Manuel yazımdan saatler kazanın"

#: .\core\views.py:304
msgid "Launch your QR menu faster"
msgstr "QR menünüzü daha hızlı yayına alın"

#: .\core\views.py:305
msgid "Reduce human data-entry errors"
msgstr "İnsan kaynaklı veri girişi hatalarını azaltın"

#: .\core\views.py:310 .\templates\partials\navbar.html:48
msgid "Customizable Themes"
msgstr "Özelleştirilebilir Temalar"

#: .\core\views.py:311
msgid "Match your menu design to your restaurant brand."
msgstr "Menü tasarımınızı restoran markanıza uyarlayın."

#: .\core\views.py:312
msgid ""
"Choose from modern themes and customize colors, typography, and layout in a "
"few clicks."
msgstr ""
"Modern temaları seçin ve renk, tipografi ve düzeni birkaç tıkla "
"özelleştirin."

#: .\core\views.py:315
msgid "Consistent brand identity"
msgstr "Tutarlı marka kimliği"

#: .\core\views.py:316
msgid "Better visual experience for guests"
msgstr "Misafirler için daha iyi görsel deneyim"

#: .\core\views.py:317
msgid "Faster edits with pre-built styles"
msgstr "Hazır stiller ile daha hızlı düzenleme"

#: .\core\views.py:322 .\templates\partials\navbar.html:49
msgid "Dedicated Support"
msgstr "Özel Destek"

#: .\core\views.py:323
msgid "Real help when you need it most."
msgstr "En çok ihtiyacınız olduğunda gerçek yardım."

#: .\core\views.py:324
msgid ""
"Our team helps with setup, menu updates, and optimization so your staff can "
"focus on service."
msgstr ""
"Ekibimiz kurulum, menü güncellemeleri ve optimizasyonda size yardımcı olur, "
"personeliniz servise odaklanır."

#: .\core\views.py:327
msgid "Priority support for urgent issues"
msgstr "Acil sorunlar için öncelikli destek"

#: .\core\views.py:328
msgid "Faster onboarding for new branches"
msgstr "Yeni şubeler için daha hızlı katılım"

#: .\core\views.py:329
msgid "Better uptime and smoother operations"
msgstr "Daha iyi çalışma süresi ve daha akıcı operasyonlar"

#: .\core\views.py:334 .\templates\partials\navbar.html:50
msgid "Menu Creation"
msgstr "Menü Oluşturma"

#: .\core\views.py:335
msgid "Build clean, organized menus your guests love."
msgstr "Misafirlerin seveceği düzenli ve temiz menüler oluşturun."

#: .\core\views.py:336
msgid ""
"Create categories, add dish photos, set prices, and reorder items with a "
"simple dashboard."
msgstr ""
"Basit bir panelden kategoriler oluşturun, yemek fotoğrafları ekleyin, fiyat "
"belirleyin ve öğeleri yeniden sıralayın."

#: .\core\views.py:339
msgid "Unlimited menu items"
msgstr "Sınırsız menü öğesi"

#: .\core\views.py:340
msgid "Quick editing for daily changes"
msgstr "Günlük değişiklikler için hızlı düzenleme"

#: .\core\views.py:341
msgid "Clear structure for better ordering"
msgstr "Daha iyi sipariş için net yapı"

#: .\core\views.py:346 .\templates\partials\navbar.html:51
msgid "Multi-Service Management"
msgstr "Çoklu Hizmet Yönetimi"

#: .\core\views.py:347
msgid "Run dine-in, takeaway, and delivery from one panel."
msgstr "Restoranda, gel-al ve teslimatı tek panelden yönetin."

#: .\core\views.py:348
msgid ""
"Manage service types, availability, and order flow in one place without "
"switching tools."
msgstr ""
"Servis türleri, uygunluk ve sipariş akışını tek yerden yönetin; araç "
"değiştirmeye gerek yok."

#: .\core\views.py:351
msgid "One dashboard for all channels"
msgstr "Tüm kanallar için tek panel"

#: .\core\views.py:352
msgid "Less staff confusion"
msgstr "Personel karışıklığı azalır"

#: .\core\views.py:353
msgid "Higher operational speed"
msgstr "Daha yüksek operasyonel hız"

#: .\core\views.py:358 .\templates\partials\navbar.html:52
msgid "Multilingual Support"
msgstr "Çok Dilli Destek"

#: .\core\views.py:359
msgid "Serve local and international guests better."
msgstr "Yerel ve uluslararası misafirlere daha iyi hizmet edin."

#: .\core\views.py:360
msgid ""
"Offer your menu in multiple languages and let customers switch language "
"instantly."
msgstr ""
"Menünüzü birden fazla dilde sunun ve müşteriler dili anında değiştirsin."

#: .\core\views.py:363
msgid "Better guest experience for tourists"
msgstr "Turistler için daha iyi deneyim"

#: .\core\views.py:364
msgid "Fewer ordering mistakes"
msgstr "Daha az sipariş hatası"

#: .\core\views.py:365
msgid "Higher conversion on the menu page"
msgstr "Menü sayfasında daha yüksek dönüşüm"

#: .\core\views.py:370 .\templates\partials\navbar.html:53
msgid "Online Ordering"
msgstr "Online Sipariş"

#: .\core\views.py:371
msgid "Take orders directly from the QR menu."
msgstr "Siparişleri doğrudan QR menüden alın."

#: .\core\views.py:372
msgid ""
"Guests browse, add to cart, and checkout from their phone with a smooth "
"mobile-first flow."
msgstr ""
"Misafirler telefonlarından göz atar, sepete ekler ve akıcı bir mobil "
"öncelikli akışla öder."

#: .\core\views.py:375
msgid "Increase average order value"
msgstr "Ortalama sipariş değerini artırın"

#: .\core\views.py:376
msgid "Reduce table waiting time"
msgstr "Masa bekleme süresini azaltın"

#: .\core\views.py:377
msgid "Capture more takeaway orders"
msgstr "Daha fazla gel-al siparişi yakalayın"

#: .\core\views.py:382 .\templates\partials\navbar.html:54
msgid "PDF Export"
msgstr "PDF Dışa Aktarma"

#: .\core\views.py:383
msgid "Keep digital and printed menus in sync."
msgstr "Dijital ve basılı menüleri senkron tutun."

#: .\core\views.py:384
msgid ""
"Export your latest menu as PDF for table cards, flyers, and offline sharing."
msgstr ""
"Son menünüzü masa kartları, broşürler ve çevrimdışı paylaşım için PDF olarak"
" dışa aktarın."

#: .\core\views.py:387
msgid "Ready-to-print output"
msgstr "Baskıya hazır çıktı"

#: .\core\views.py:388
msgid "Consistent branding across channels"
msgstr "Tüm kanallarda tutarlı marka"

#: .\core\views.py:389
msgid "Simple backup of menu data"
msgstr "Menü verilerinin basit yedeği"

#: .\core\views.py:394 .\templates\partials\navbar.html:55
msgid "Real-Time Updates"
msgstr "Gerçek Zamanlı Güncellemeler"

#: .\core\views.py:395
msgid "Update prices and stock instantly."
msgstr "Fiyat ve stoku anında güncelleyin."

#: .\core\views.py:396
msgid ""
"Publish menu changes live in seconds so guests always see accurate "
"information."
msgstr ""
"Menü değişikliklerini saniyeler içinde yayına alın; misafirler her zaman "
"doğru bilgi görsün."

#: .\core\views.py:399
msgid "No stale menu data"
msgstr "Bayat menü verisi yok"

#: .\core\views.py:400
msgid "Fewer customer complaints"
msgstr "Daha az müşteri şikayeti"

#: .\core\views.py:401
msgid "Faster reaction to peak-hour demand"
msgstr "Yoğun saatlerde talebe daha hızlı yanıt"

#: .\core\views.py:406 .\templates\partials\navbar.html:56
msgid "Secure Payment Processing"
msgstr "Güvenli Ödeme İşleme"

#: .\core\views.py:407
msgid "Accept payments safely and confidently."
msgstr "Ödemeleri güvenle ve emniyetle kabul edin."

#: .\core\views.py:408
msgid ""
"Support secure online checkout with trusted gateways and encrypted "
"transaction flow."
msgstr ""
"Güvenilir ödeme geçitleri ve şifreli işlem akışı ile güvenli online ödeme."

#: .\core\views.py:411
msgid "Safer transactions"
msgstr "Daha güvenli işlemler"

#: .\core\views.py:412
msgid "More trust from customers"
msgstr "Müşterilerden daha fazla güven"

#: .\core\views.py:413
msgid "Higher checkout completion"
msgstr "Daha yüksek ödeme tamamlama oranı"

#: .\core\views.py:418 .\templates\partials\navbar.html:57
msgid "Smart Order Management"
msgstr "Akıllı Sipariş Yönetimi"

#: .\core\views.py:419
msgid "Track every order in one clean queue."
msgstr "Her siparişi tek, temiz bir kuyrukta izleyin."

#: .\core\views.py:420
msgid ""
"Filter by status, prioritize prep, and keep front-of-house and kitchen fully"
" synchronized."
msgstr ""
"Duruma göre filtreleyin, hazırlığı önceliklendirin ve salon ile mutfağı "
"tamamen senkron tutun."

#: .\core\views.py:423
msgid "Clear workflow for staff"
msgstr "Personel için net iş akışı"

#: .\core\views.py:424
msgid "Faster fulfillment"
msgstr "Daha hızlı sipariş karşılama"

#: .\core\views.py:425
msgid "Improved customer satisfaction"
msgstr "Daha yüksek müşteri memnuniyeti"

#: .\templates\admin\business_menu_section.html:11
