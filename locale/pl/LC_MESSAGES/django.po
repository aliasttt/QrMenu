msgstr "Warunki korzystania"

#: .\templates_bonusweb\business_menu\subscribe.html:124
msgid "Enter the email for your restaurant account."
msgstr "Wpisz e-mail do swojego konta restauracji."

#: .\templates_bonusweb\business_menu\subscribe.html:129
msgid "Redirecting..."
msgstr "Przekierowywanie…"

#: .\templates_bonusweb\business_menu\subscribe.html:142
msgid "Could not start checkout. Please try again."
msgstr "Nie można uruchomić wymeldowania. Proszę spróbować jeszcze raz."

#: .\templates_bonusweb\business_menu\subscribe.html:147
msgid "Request failed. Please try again."
msgstr "Prośba nie powiodła się. Proszę spróbować jeszcze raz."

#: .\templates_bonusweb\business_menu\subscribe_cancel.html:7
msgid ""
"You cancelled the payment. No charge was made. You can try again anytime to "
"upgrade your plan and enable online payments from your digital menu."
msgstr ""
"Anulowałeś płatność. Nie pobrano żadnej opłaty. Możesz spróbować ponownie, "
"aby ulepszyć plan i włączyć płatności online."

#: .\templates_bonusweb\business_menu\subscribe_cancel.html:10
msgid "Try again – Start Plan"
msgstr "Spróbuj ponownie – Rozpocznij plan"

#: .\templates_bonusweb\business_menu\subscribe_cancel.html:12
#: .\templates_bonusweb\business_menu\subscribe_success.html:11
#: .\templates_bonusweb\business_menu\subscribe_success.html:13
msgid "Back to Dashboard"
msgstr "Wróć do pulpitu"

#: .\templates_bonusweb\business_menu\subscribe_success.html:3
msgid "Subscription complete"
msgstr "Subskrypcja zakończona"

#: .\templates_bonusweb\business_menu\subscribe_success.html:6
msgid "Thank you!"
msgstr "Dziękujemy!"

#: .\templates_bonusweb\business_menu\subscribe_success.html:7
msgid ""
"Your subscription is active. You can now use the app and connect your Stripe"
" account to receive customer payments."
msgstr ""
"Twoja subskrypcja jest aktywna. Możesz teraz korzystać z aplikacji i "
"podłączyć Stripe, aby przyjmować płatności."

#: .\templates_bonusweb\business_menu\subscribe_success.html:9
msgid "Connect Stripe to receive payments"
msgstr "Połącz Stripe, aby przyjmować płatności"

