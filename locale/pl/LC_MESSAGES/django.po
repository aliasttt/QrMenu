#: .\core\views.py:106
msgid "Owner, Basil House"
msgstr "Właścicielka, Basil House"

#: .\core\views.py:106
msgid "We increased table turnover with faster ordering."
msgstr "Zwiększyliśmy rotację stolików dzięki szybszym zamówieniom."

#: .\core\views.py:107
msgid "Manager, South Fork"
msgstr "Menedżer, South Fork"

#: .\core\views.py:107
msgid "Campaigns helped us fill off-peak hours."
msgstr "Kampanie pomogły nam zapełnić godziny poza szczytem."

#: .\core\views.py:108
msgid "Founder, Luna Cafe"
msgstr "Założycielka, Luna Cafe"

#: .\core\views.py:108
msgid "Our staff now spends less time taking manual orders."
msgstr "Nasz zespół spędza teraz mniej czasu na ręcznym przyjmowaniu zamówień."

#: .\core\views.py:111 .\core\views.py:133
msgid "AI menu import"
msgstr "Import menu z AI"

#: .\core\views.py:112 .\core\views.py:134
msgid "Multilingual menus"
msgstr "Menu wielojęzyczne"

#: .\core\views.py:113 .\core\views.py:135
msgid "QR code generation"
msgstr "Generowanie kodów QR"

#: .\core\views.py:114 .\core\views.py:136
msgid "Order management"
msgstr "Zarządzanie zamówieniami"

#: .\core\views.py:115 .\core\views.py:137
msgid "Campaign engine"
msgstr "Silnik kampanii"

#: .\core\views.py:116 .\core\views.py:138
msgid "Daily analytics"
msgstr "Codzienna analityka"

#: .\core\views.py:117 .\core\views.py:139
msgid "Category controls"
msgstr "Kontrola kategorii"

#: .\core\views.py:118 .\core\views.py:140
msgid "Live availability"
msgstr "Dostępność na żywo"

#: .\core\views.py:119 .\core\views.py:141
msgid "POS-ready payloads"
msgstr "Dane gotowe dla POS"

#: .\core\views.py:120 .\core\views.py:142
msgid "Mobile-first pages"
msgstr "Strony mobile-first"

#: .\core\views.py:121 .\core\views.py:143
msgid "Role-ready panel"
msgstr "Panel z rolami"

#: .\core\views.py:122 .\core\views.py:144
msgid "Conversion focused UI"
msgstr "Interfejs skupiony na konwersji"

#: .\core\views.py:133
msgid ""
"Upload a PDF or photo and we extract your dishes and prices automatically."
msgstr "Wyślij PDF lub zdjęcie, a my automatycznie wyodrębnimy dania i ceny."

#: .\core\views.py:134
msgid ""
"Serve your menu in multiple languages and switch by customer preference."
msgstr "Serwuj menu w wielu językach i przełączaj według preferencji klienta."

#: .\core\views.py:135
msgid "Generate and download QR codes for tables, takeaway, and delivery."
msgstr "Generuj i pobieraj kody QR dla stolików, odbiorów i dostaw."

#: .\core\views.py:136
msgid ""
"Receive, track, and fulfill orders from one dashboard with status updates."
msgstr "Odbieraj, śledź i realizuj zamówienia z jednego panelu z aktualizacjami statusu."

#: .\core\views.py:137
msgid ""
"Create time-based discounts, happy hours, and target specific categories."
msgstr "Twórz rabaty czasowe, happy hours i celuj w konkretne kategorie."

#: .\core\views.py:138
msgid "View orders, revenue, and top items with simple charts and exports."
msgstr "Zobacz zamówienia, przychody i top produkty w prostych wykresach i eksportach."

#: .\core\views.py:139
msgid "Organize items into categories and reorder with drag-and-drop."
msgstr "Uporządkuj pozycje w kategorie i zmieniaj kolejność przez przeciąganie."

#: .\core\views.py:140
msgid "Mark items as out of stock and hide or show sections by schedule."
msgstr "Oznaczaj pozycje jako niedostępne i ukrywaj/pokazuj sekcje wg harmonogramu."

#: .\core\views.py:141
msgid "Send orders to your POS or kitchen display via webhooks or API."
msgstr "Wysyłaj zamówienia do POS lub ekranu kuchni przez webhooks lub API."

#: .\core\views.py:142
msgid "Menus and checkout are optimized for phones and tablets."
msgstr "Menu i finalizacja zoptymalizowane na telefony i tablety."

#: .\core\views.py:143
msgid "Invite staff with roles: admin, manager, or view-only."
msgstr "Zapraszaj personel z rolami: admin, menedżer lub tylko podgląd."

#: .\core\views.py:144
msgid "Clean design and clear CTAs to maximize add-to-cart and checkout."
msgstr "Czysty design i wyraźne CTA maksymalizujące dodania do koszyka i checkout."

#: .\core\views.py:147
msgid "Can I use my own domain?"
msgstr "Czy mogę użyć własnej domeny?"

#: .\core\views.py:147
msgid ""
"Yes. You can connect a custom domain (e.g. menu.yourrestaurant.com) from the "
"settings panel."
msgstr "Tak. Możesz podłączyć własną domenę (np. menu.twojarestauracja.com) w panelu ustawień."

#: .\core\views.py:148
msgid "Is there a mobile app for staff?"
msgstr "Czy jest aplikacja mobilna dla personelu?"

#: .\core\views.py:148
msgid ""
"The panel is fully responsive; you can use it from any browser. Native apps "
"are on our roadmap."
msgstr "Panel jest w pełni responsywny; można go używać z każdej przeglądarki. Aplikacje natywne są w planach."

#: .\core\views.py:149
msgid "How do I print QR codes?"
msgstr "Jak wydrukować kody QR?"

#: .\core\views.py:149
msgid ""
"Generate QR codes from the dashboard and download as PNG or SVG. Print on "
"table tents or stickers."
msgstr "Generuj kody QR w panelu i pobieraj jako PNG lub SVG. Drukuj na stojakach lub naklejkach."

#: .\core\views.py:150
msgid "Do you integrate with POS?"
msgstr "Integrujecie z POS?"

#: .\core\views.py:150
msgid ""
"We support webhooks and an API so you can push orders to your POS or kitchen "
"display system."
msgstr "Wspieramy webhooks i API, więc możesz wysyłać zamówienia do POS lub ekranu kuchni."

#: .\core\views.py:157
msgid "Set up your menu"
msgstr "Skonfiguruj menu"

#: .\core\views.py:157
msgid ""
"Create categories, add dishes with prices and photos, and set availability."
msgstr "Twórz kategorie, dodawaj dania z cenami i zdjęciami oraz ustaw dostępność."

#: .\core\views.py:157
msgid "Drag-and-drop reorder, bulk edit, or import from spreadsheet."
msgstr "Zmieniaj kolejność metodą przeciągnij i upuść, edytuj masowo lub importuj z arkusza."

#: .\core\views.py:158
msgid "Generate your QR"
msgstr "Wygeneruj kod QR"

#: .\core\views.py:158
msgid ""
"Print QR codes for each table or area. Customers scan to open your menu."
msgstr "Wydrukuj kody QR dla każdego stolika lub obszaru. Klienci skanują, aby otworzyć menu."

#: .\core\views.py:158
msgid "Download PNG or SVG, print on table tents or stickers."
msgstr "Pobierz jako PNG lub SVG, drukuj na stojakach lub naklejkach."

#: .\core\views.py:159
msgid "Get online orders"
msgstr "Otrzymuj zamówienia online"

#: .\core\views.py:159
msgid ""
"Customers browse, add to cart, and checkout. You receive and fulfill orders."
msgstr "Klienci przeglądają, dodają do koszyka i płacą. Ty odbierasz i realizujesz zamówienia."

#: .\core\views.py:159
msgid "Optional: connect to POS or kitchen display."
msgstr "Opcjonalnie: podłącz do POS lub ekranu kuchni."

#: .\core\views.py:170
msgid "QR menu — customers scan and browse your menu on their phone"
msgstr "Menu QR — klienci skanują i przeglądają menu na telefonie."

#: .\core\views.py:171
msgid "Unlimited menu items and categories"
msgstr "Nieograniczone pozycje i kategorie"

#: .\core\views.py:172
msgid "Unlimited QR codes for tables and takeaway"
msgstr "Nieograniczone kody QR dla stolików i odbiorów"

#: .\core\views.py:173
msgid "Online ordering — guests order and pay from the same link"
msgstr "Zamówienia online — goście składają i opłacają zamówienia z tego samego linku."

#: .\core\views.py:174
msgid "Customizable themes to match your brand"
msgstr "Konfigurowalne motywy pasujące do marki"

#: .\core\views.py:175
msgid "Campaigns & discounts (happy hour, daily specials)"
msgstr "Kampanie i rabaty (happy hour, oferty dnia)"

#: .\core\views.py:176
msgid "Multilingual menu support"
msgstr "Obsługa menu wielojęzycznego"

#: .\core\views.py:177
msgid "Real-time updates — change prices and availability instantly"
msgstr "Aktualizacje na żywo — natychmiast zmieniaj ceny i dostępność."

#: .\core\views.py:178
msgid "Basic analytics — see what sells"
msgstr "Podstawowa analityka — sprawdź, co się sprzedaje."

#: .\core\views.py:179
msgid "Email & WhatsApp support"
msgstr "Wsparcie e-mail i WhatsApp"

#: .\core\views.py:183
msgid "Win more orders"
msgstr "Zdobądź więcej zamówień"

#: .\core\views.py:183
msgid ""
"Guests order directly from the QR menu. No waiting for staff—faster turnover "
"and higher revenue."
msgstr "Goście zamawiają bezpośrednio z menu QR. Bez czekania na obsługę — szybsza rotacja i wyższy przychód."

#: .\core\views.py:184
msgid "Look professional"
msgstr "Wyglądaj profesjonalnie"

#: .\core\views.py:184
msgid ""
"A clean digital menu and your own domain build trust. Stand out from "
"competitors still using paper."
msgstr "Czyste cyfrowe menu i własna domena budują zaufanie. Wyróżnij się na tle konkurencji z papierowym menu."

#: .\core\views.py:185
msgid "One subscription, everything included"
msgstr "Jedna subskrypcja — wszystko w zestawie"

#: .\core\views.py:185
msgid ""
"No per-order fees or hidden costs. One annual fee covers menu, ordering, and "
"support."
msgstr "Brak opłat za zamówienie i ukrytych kosztów. Roczna opłata obejmuje menu, zamówienia i wsparcie."

#: .\core\views.py:186
msgid "Launch in minutes"
msgstr "Uruchom w minuty"

#: .\core\views.py:186
msgid ""
"Add your dishes, print a QR code, and go live. No IT or design skills needed."
msgstr "Dodaj dania, wydrukuj kod QR i wystartuj. Bez wiedzy IT ani projektowej."

#: .\core\views.py:189
msgid "What is included in the price?"
msgstr "Co jest wliczone w cenę?"

#: .\core\views.py:189
msgid ""
"Everything: QR menu, online ordering, unlimited items and QR codes, "
"campaigns, custom domain option, themes, and support. One annual "
"subscription, no per-order fees."
msgstr "Wszystko: menu QR, zamówienia online, nieograniczone pozycje i kody QR, kampanie, własna domena, motywy i wsparcie. Jedna subskrypcja roczna, bez opłat za zamówienie."

#: .\core\views.py:190
msgid "Is there a free trial?"
msgstr "Czy jest darmowy okres próbny?"

#: .\core\views.py:190
msgid ""
"Yes. Start with a free trial to build your menu and test ordering. No card "
"required until you go live."
msgstr "Tak. Zacznij od darmowego okresu próbnego, aby zbudować menu i przetestować zamówienia. Karta nie jest wymagana do uruchomienia."

#: .\core\views.py:191
msgid "Why 19% VAT?"
msgstr "Dlaczego 19% VAT?"

#: .\core\views.py:191
#, python-format
msgid ""
"We are VAT-registered in the EU. If you are in the EU and liable for VAT, "
"19% is added at checkout (total €238/year). If you are outside the EU or VAT-"
"exempt, the amount may differ."
msgstr "Jesteśmy zarejestrowani jako podatnik VAT w UE. W UE i przy obowiązku VAT doliczamy 19% (rocznie €238). Poza UE lub przy zwolnieniu z VAT kwota może się różnić."

#: .\core\views.py:211 .\templates\partials\navbar.html:47
msgid "AI Menu Import"
msgstr "Import menu z AI"

#: .\core\views.py:212
msgid "Turn paper menus into digital menus in minutes."
msgstr "Przekształć menu papierowe w cyfrowe w kilka minut."

#: .\core\views.py:213
msgid ""
"Upload a photo or PDF and let AI extract dish names, descriptions, and "
"prices automatically."
msgstr "Wyślij zdjęcie lub PDF, a AI automatycznie wyodrębni nazwy dań, opisy i ceny."

#: .\core\views.py:216
msgid "Save hours of manual typing"
msgstr "Zaoszczędź godziny ręcznego wpisywania"

#: .\core\views.py:217
msgid "Launch your QR menu faster"
msgstr "Uruchom menu QR szybciej"

#: .\core\views.py:218
msgid "Reduce human data-entry errors"
msgstr "Ogranicz błędy ludzkie przy wprowadzaniu danych"

#: .\core\views.py:223 .\templates\partials\navbar.html:48
msgid "Customizable Themes"
msgstr "Konfigurowalne motywy"

#: .\core\views.py:224
msgid "Match your menu design to your restaurant brand."
msgstr "Dopasuj wygląd menu do marki restauracji."

#: .\core\views.py:225
msgid ""
"Choose from modern themes and customize colors, typography, and layout in a "
"few clicks."
msgstr "Wybierz spośród nowoczesnych motywów i dostosuj kolory, typografię i układ w kilku kliknięciach."

#: .\core\views.py:228
msgid "Consistent brand identity"
msgstr "Spójna tożsamość marki"

#: .\core\views.py:229
msgid "Better visual experience for guests"
msgstr "Lepsze doświadczenie wizualne dla gości"

#: .\core\views.py:230
msgid "Faster edits with pre-built styles"
msgstr "Szybsza edycja z gotowymi stylami"

#: .\core\views.py:235 .\templates\partials\navbar.html:49
msgid "Dedicated Support"
msgstr "Dedykowane wsparcie"

#: .\core\views.py:236
msgid "Real help when you need it most."
msgstr "Prawdziwe wsparcie, gdy najbardziej go potrzebujesz."

#: .\core\views.py:237
msgid ""
"Our team helps with setup, menu updates, and optimization so your staff can "
"focus on service."
msgstr "Nasz zespół pomaga w konfiguracji, aktualizacjach menu i optymalizacji, byś personel mógł skupić się na obsłudze."

#: .\core\views.py:240
msgid "Priority support for urgent issues"
msgstr "Priorytetowe wsparcie dla pilnych problemów"

#: .\core\views.py:241
msgid "Faster onboarding for new branches"
msgstr "Szybsze wdrożenie nowych oddziałów"

#: .\core\views.py:242
msgid "Better uptime and smoother operations"
msgstr "Lepsza dostępność i płynniejsze operacje"

#: .\core\views.py:247 .\templates\partials\navbar.html:50
msgid "Menu Creation"
msgstr "Tworzenie menu"

#: .\core\views.py:248
msgid "Build clean, organized menus your guests love."
msgstr "Twórz przejrzyste, uporządkowane menu, które pokochają twoi goście."

#: .\core\views.py:249
msgid ""
"Create categories, add dish photos, set prices, and reorder items with a "
"simple dashboard."
msgstr "Twórz kategorie, dodawaj zdjęcia dań, ustawiaj ceny i zmieniaj kolejność z prostego panelu."

#: .\core\views.py:252
msgid "Unlimited menu items"
msgstr "Nieograniczone pozycje menu"

#: .\core\views.py:253
msgid "Quick editing for daily changes"
msgstr "Szybka edycja codziennych zmian"

#: .\core\views.py:254
msgid "Clear structure for better ordering"
msgstr "Przejrzysta struktura ułatwiająca zamawianie"

#: .\core\views.py:259 .\templates\partials\navbar.html:51
msgid "Multi-Service Management"
msgstr "Zarządzanie wieloma usługami"

#: .\core\views.py:260
msgid "Run dine-in, takeaway, and delivery from one panel."
msgstr "Zarządzaj na miejscu, odbiorem i dostawą z jednego panelu."

#: .\core\views.py:261
msgid ""
"Manage service types, availability, and order flow in one place without "
"switching tools."
msgstr "Zarządzaj typami usług, dostępnością i przepływem zamówień w jednym miejscu, bez przełączania narzędzi."

#: .\core\views.py:264
msgid "One dashboard for all channels"
msgstr "Jeden panel dla wszystkich kanałów"

#: .\core\views.py:265
msgid "Less staff confusion"
msgstr "Mniej zamieszania wśród personelu"

#: .\core\views.py:266
msgid "Higher operational speed"
msgstr "Wyższa prędkość operacyjna"

#: .\core\views.py:271 .\templates\partials\navbar.html:52
msgid "Multilingual Support"
msgstr "Wsparcie wielojęzyczne"

#: .\core\views.py:272
msgid "Serve local and international guests better."
msgstr "Lepiej obsługuj gości lokalnych i międzynarodowych."

#: .\core\views.py:273
msgid ""
"Offer your menu in multiple languages and let customers switch language "
"instantly."
msgstr "Serwuj menu w wielu językach i pozwól klientom natychmiast zmienić język."

#: .\core\views.py:276
msgid "Better guest experience for tourists"
msgstr "Lepsze doświadczenie dla turystów"

#: .\core\views.py:277
msgid "Fewer ordering mistakes"
msgstr "Mniej pomyłek w zamówieniach"

#: .\core\views.py:278
msgid "Higher conversion on the menu page"
msgstr "Wyższa konwersja na stronie menu"

#: .\core\views.py:283 .\templates\partials\navbar.html:53
msgid "Online Ordering"
msgstr "Zamówienia online"

#: .\core\views.py:284
msgid "Take orders directly from the QR menu."
msgstr "Odbieraj zamówienia bezpośrednio z menu QR."

#: .\core\views.py:285
msgid ""
"Guests browse, add to cart, and checkout from their phone with a smooth "
"mobile-first flow."
msgstr "Goście przeglądają, dodają do koszyka i płacą z telefonu w płynnym flow mobile-first."

#: .\core\views.py:288
msgid "Increase average order value"
msgstr "Zwiększ średnią wartość zamówienia"

#: .\core\views.py:289
msgid "Reduce table waiting time"
msgstr "Skróć czas oczekiwania przy stoliku"

#: .\core\views.py:290
msgid "Capture more takeaway orders"
msgstr "Zdobądź więcej zamówień na odbiór"

#: .\core\views.py:295 .\templates\partials\navbar.html:54
msgid "PDF Export"
msgstr "Eksport do PDF"

#: .\core\views.py:296
msgid "Keep digital and printed menus in sync."
msgstr "Utrzymuj menu cyfrowe i drukowane w synchronizacji."

#: .\core\views.py:297
msgid ""
"Export your latest menu as PDF for table cards, flyers, and offline sharing."
msgstr "Eksportuj najnowsze menu do PDF na stojaki, ulotki i udostępnianie offline."

#: .\core\views.py:300
msgid "Ready-to-print output"
msgstr "Gotowy do druku wynik"

#: .\core\views.py:301
msgid "Consistent branding across channels"
msgstr "Spójny branding we wszystkich kanałach"

#: .\core\views.py:302
msgid "Simple backup of menu data"
msgstr "Prosta kopia zapasowa danych menu"

#: .\core\views.py:307 .\templates\partials\navbar.html:55
msgid "Real-Time Updates"
msgstr "Aktualizacje w czasie rzeczywistym"

#: .\core\views.py:308
msgid "Update prices and stock instantly."
msgstr "Aktualizuj ceny i stany magazynowe natychmiast."

#: .\core\views.py:309
msgid ""
"Publish menu changes live in seconds so guests always see accurate "
"information."
msgstr "Publikuj zmiany menu w kilka sekund, aby goście widzieli aktualne informacje."

#: .\core\views.py:312
msgid "No stale menu data"
msgstr "Brak nieaktualnych danych menu"

#: .\core\views.py:313
msgid "Fewer customer complaints"
msgstr "Mniej reklamacji klientów"

#: .\core\views.py:314
msgid "Faster reaction to peak-hour demand"
msgstr "Szybsza reakcja na szczytowe zapotrzebowanie"

#: .\core\views.py:319 .\templates\partials\navbar.html:56
msgid "Secure Payment Processing"
msgstr "Bezpieczne przetwarzanie płatności"

#: .\core\views.py:320
msgid "Accept payments safely and confidently."
msgstr "Przyjmuj płatności bezpiecznie i z pełnym zaufaniem."

#: .\core\views.py:321
msgid ""
"Support secure online checkout with trusted gateways and encrypted "
"transaction flow."
msgstr "Wspiera bezpieczny checkout online z zaufanymi bramkami i szyfrowanym flow transakcji."

#: .\core\views.py:324
msgid "Safer transactions"
msgstr "Bezpieczniejsze transakcje"

#: .\core\views.py:325
msgid "More trust from customers"
msgstr "Większe zaufanie klientów"

#: .\core\views.py:326
msgid "Higher checkout completion"
msgstr "Wyższy współczynnik ukończenia checkoutu"

#: .\core\views.py:331 .\templates\partials\navbar.html:57
msgid "Smart Order Management"
msgstr "Inteligentne zarządzanie zamówieniami"

#: .\core\views.py:332
msgid "Track every order in one clean queue."
msgstr "Śledź każde zamówienie w jednej przejrzystej kolejce."

#: .\core\views.py:333
msgid ""
"Filter by status, prioritize prep, and keep front-of-house and kitchen fully "
"synchronized."
msgstr "Filtruj według statusu, priorytetyzuj przygotowanie i utrzymuj salę oraz kuchnię w pełnej synchronizacji."

#: .\core\views.py:336
msgid "Clear workflow for staff"
msgstr "Jasny workflow dla personelu"

#: .\core\views.py:337
msgid "Faster fulfillment"
msgstr "Szybsza realizacja"

#: .\core\views.py:338
msgid "Improved customer satisfaction"
msgstr "Wyższa satysfakcja klienta"

