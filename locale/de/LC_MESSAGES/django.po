#: .\core\views.py:359
msgid "Serve local and international guests better."
msgstr "Lokale und internationale Gäste besser bedienen."

#: .\core\views.py:360
msgid ""
"Offer your menu in multiple languages and let customers switch language "
"instantly."
msgstr ""
"Bieten Sie Ihr Menü in mehreren Sprachen an — Kunden wechseln die Sprache "
"sofort."

#: .\core\views.py:363
msgid "Better guest experience for tourists"
msgstr "Besseres Gästeerlebnis für Touristen"

#: .\core\views.py:364
msgid "Fewer ordering mistakes"
msgstr "Weniger Bestellfehler"

#: .\core\views.py:365
msgid "Higher conversion on the menu page"
