msgstr "Sichere Zahlungsabwicklung"

#: .\core\views.py:407
msgid "Accept payments safely and confidently."
msgstr "Zahlungen sicher und mit Vertrauen entgegennehmen."

#: .\core\views.py:408
msgid ""
"Support secure online checkout with trusted gateways and encrypted "
"transaction flow."
msgstr ""
"Sicherer Online-Checkout mit vertrauenswürdigen Gateways und verschlüsseltem"
" Transaktionsfluss."

#: .\core\views.py:411
msgid "Safer transactions"
msgstr "Sicherere Transaktionen"

#: .\core\views.py:412
msgid "More trust from customers"
msgstr "Mehr Kundenvertrauen"

#: .\core\views.py:413
msgid "Higher checkout completion"
msgstr "Höhere Checkout-Abschlussrate"

#: .\core\views.py:418 .\templates\partials\navbar.html:57
msgid "Smart Order Management"
msgstr "Intelligente Bestellverwaltung"

#: .\core\views.py:419
msgid "Track every order in one clean queue."
msgstr "Jede Bestellung in einer aufgeräumten Warteschlange verfolgen."

#: .\core\views.py:420
msgid ""
"Filter by status, prioritize prep, and keep front-of-house and kitchen fully"
" synchronized."
msgstr ""
"Nach Status filtern, Zubereitung priorisieren und Front-of-House und Küche "
"voll synchron halten."

#: .\core\views.py:423
msgid "Clear workflow for staff"
msgstr "Klarer Arbeitsablauf für das Personal"

#: .\core\views.py:424
msgid "Faster fulfillment"
msgstr "Schnellere Erfüllung"

#: .\core\views.py:425
