#: .\core\views.py:327
msgid "Priority support for urgent issues"
msgstr "Priorisierter Support für dringende Fälle"

#: .\core\views.py:328
msgid "Faster onboarding for new branches"
msgstr "Schnelleres Onboarding für neue Filialen"

#: .\core\views.py:329
msgid "Better uptime and smoother operations"
msgstr "Bessere Verfügbarkeit und reibungsloserer Betrieb"

