msgstr "Echtzeit-Updates"

#: .\core\views.py:395
msgid "Update prices and stock instantly."
msgstr "Preise und Bestand sofort aktualisieren."

#: .\core\views.py:396
msgid ""
"Publish menu changes live in seconds so guests always see accurate "
"information."
msgstr ""
"Menüänderungen in Sekunden live schalten, damit Gäste stets korrekte Infos "
"sehen."

#: .\core\views.py:399
msgid "No stale menu data"
msgstr "Keine veralteten Menüdaten"

#: .\core\views.py:400
msgid "Fewer customer complaints"
msgstr "Weniger Kundenbeschwerden"

#: .\core\views.py:401
msgid "Faster reaction to peak-hour demand"
msgstr "Schnellere Reaktion auf Spitzenzeiten"

#: .\core\views.py:406 .\templates\partials\navbar.html:56
