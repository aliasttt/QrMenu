msgstr "Menü-Erstellung"

#: .\core\views.py:335
msgid "Build clean, organized menus your guests love."
msgstr "Erstellen Sie saubere, gut organisierte Menüs, die Ihre Gäste lieben."

#: .\core\views.py:336
msgid ""
"Create categories, add dish photos, set prices, and reorder items with a "
"simple dashboard."
msgstr ""
"Erstellen Sie Kategorien, fügen Sie Gerichtfotos hinzu, setzen Sie Preise "
"und ordnen Sie Artikel neu — mit einem einfachen Dashboard."

#: .\core\views.py:339
msgid "Unlimited menu items"
msgstr "Unbegrenzte Menüartikel"

#: .\core\views.py:340
msgid "Quick editing for daily changes"
msgstr "Schnelle Bearbeitung für tägliche Änderungen"

#: .\core\views.py:341
msgid "Clear structure for better ordering"
msgstr "Klare Struktur für bessere Bestellungen"

#: .\core\views.py:346 .\templates\partials\navbar.html:51
