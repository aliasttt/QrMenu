msgstr "Bestellungen direkt über die QR-Speisekarte annehmen."

#: .\core\views.py:372
msgid ""
"Guests browse, add to cart, and checkout from their phone with a smooth "
"mobile-first flow."
msgstr ""
"Gäste stöbern, legen in den Warenkorb und bezahlen vom Handy — mit einem "
"reibungslosen Mobile-first-Ablauf."

#: .\core\views.py:375
msgid "Increase average order value"
msgstr "Durchschnittlichen Bestellwert erhöhen"

#: .\core\views.py:376
