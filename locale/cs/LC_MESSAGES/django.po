#: .\core\views.py:308
msgid "Update prices and stock instantly."
msgstr "Aktualizujte ceny a zásoby okamžitě."

#: .\core\views.py:309
msgid ""
"Publish menu changes live in seconds so guests always see accurate "
"information."
msgstr "Publikujte změny menu do sekund, aby hosté vždy viděli přesné informace."

#: .\core\views.py:312
msgid "No stale menu data"
