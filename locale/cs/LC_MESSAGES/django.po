#: .\core\views.py:313
msgid "Fewer customer complaints"
msgstr "Méně stížností zákazníků"

#: .\core\views.py:314
msgid "Faster reaction to peak-hour demand"
msgstr "Rychlejší reakce na špičkovou poptávku"

#: .\core\views.py:319 .\templates\partials\navbar.html:56
msgid "Secure Payment Processing"
msgstr "Bezpečné zpracování plateb"

#: .\core\views.py:320
msgid "Accept payments safely and confidently."
msgstr "Přijímejte platby bezpečně a s důvěrou."

#: .\core\views.py:321
msgid ""
"Support secure online checkout with trusted gateways and encrypted "
"transaction flow."
msgstr "Podporujte bezpečné online platby s důvěryhodnými bránami a šifrovaným tokem transakcí."

#: .\core\views.py:324
msgid "Safer transactions"
msgstr "Bezpečnější transakce"

#: .\core\views.py:325
msgid "More trust from customers"
msgstr "Vyšší důvěra zákazníků"

#: .\core\views.py:326
msgid "Higher checkout completion"
