msgid "You will be redirected to Stripe to complete payment."
msgstr "Budete přesměrováni do Stripe pro dokončení platby."

#: .\templates_bonusweb\business_menu\subscribe.html:25
msgid "Redirecting..."
msgstr "Přesměrování…"

#: .\templates_bonusweb\business_menu\subscribe.html:40
msgid "Request failed. Try again."
msgstr "Požadavek selhal. Zkuste to znovu."

#: .\templates_bonusweb\business_menu\subscribe_cancel.html:7
msgid ""
"You cancelled the payment. No charge was made. You can try again anytime to "
"upgrade your plan and enable online payments from your digital menu."
msgstr "Zrušili jste platbu. Nebylo nic strženo. Můžete to kdykoli zkusit znovu pro upgrade a aktivaci online plateb."

#: .\templates_bonusweb\business_menu\subscribe_cancel.html:10
msgid "Try again – Start Plan"
msgstr "Zkusit znovu – Spustit plán"

