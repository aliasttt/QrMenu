#: .\core\views.py:122
msgid "Owner, Basil House"
msgstr "Majitelka, Basil House"

#: .\core\views.py:122
msgid "We increased table turnover with faster ordering."
msgstr "Zvýšili jsme obrat stolů díky rychlejšímu objednávání."

#: .\core\views.py:123
msgid "Manager, South Fork"
msgstr "Manažer, South Fork"

#: .\core\views.py:123
msgid "Campaigns helped us fill off-peak hours."
msgstr "Kampaně nám pomohly zaplnit hodiny mimo špičku."

#: .\core\views.py:124
msgid "Founder, Luna Cafe"
msgstr "Zakladatelka, Luna Cafe"

#: .\core\views.py:124
msgid "Our staff now spends less time taking manual orders."
msgstr "Náš personál nyní tráví méně času ručním přijímáním objednávek."

#: .\core\views.py:127 .\core\views.py:149
msgid "AI menu import"
msgstr "AI import menu"

#: .\core\views.py:128 .\core\views.py:150
msgid "Multilingual menus"
msgstr "Vícejazyčná menu"

#: .\core\views.py:129 .\core\views.py:151
msgid "QR code generation"
msgstr "Generování QR kódů"

#: .\core\views.py:130 .\core\views.py:152
msgid "Order management"
msgstr "Správa objednávek"

#: .\core\views.py:131 .\core\views.py:153
msgid "Campaign engine"
msgstr "Modul kampaní"

#: .\core\views.py:132 .\core\views.py:154
msgid "Daily analytics"
msgstr "Denní analytika"

#: .\core\views.py:133 .\core\views.py:155
msgid "Category controls"
msgstr "Ovládání kategorií"

#: .\core\views.py:134 .\core\views.py:156
msgid "Live availability"
msgstr "Živá dostupnost"

#: .\core\views.py:135 .\core\views.py:157
msgid "POS-ready payloads"
msgstr "Data připravená pro POS"

#: .\core\views.py:136 .\core\views.py:158
msgid "Mobile-first pages"
msgstr "Stránky mobile-first"

#: .\core\views.py:137 .\core\views.py:159
msgid "Role-ready panel"
msgstr "Panel s rolemi"

#: .\core\views.py:138 .\core\views.py:160
msgid "Conversion focused UI"
msgstr "UI zaměřené na konverzi"

#: .\core\views.py:149
msgid ""
"Upload a PDF or photo and we extract your dishes and prices automatically."
msgstr "Nahrajte PDF nebo fotku a my automaticky vytáhneme jídla a ceny."

#: .\core\views.py:150
msgid ""
"Serve your menu in multiple languages and switch by customer preference."
msgstr ""
"Nabídněte menu ve více jazycích a přepínejte podle preference zákazníka."

#: .\core\views.py:151
msgid "Generate and download QR codes for tables, takeaway, and delivery."
msgstr "Vytvořte a stáhněte QR kódy pro stoly, vyzvednutí a doručení."

#: .\core\views.py:152
msgid ""
"Receive, track, and fulfill orders from one dashboard with status updates."
msgstr ""
"Přijímejte, sledujte a vyřizujte objednávky z jedné nástěnky s aktualizacemi"
" stavu."

#: .\core\views.py:153
msgid ""
"Create time-based discounts, happy hours, and target specific categories."
msgstr ""
"Vytvářejte časové slevy, happy hours a cílejte na konkrétní kategorie."

#: .\core\views.py:154
msgid "View orders, revenue, and top items with simple charts and exports."
msgstr ""
"Prohlédněte si objednávky, tržby a top položky s jednoduchými grafy a "
"exporty."

#: .\core\views.py:155
msgid "Organize items into categories and reorder with drag-and-drop."
msgstr "Organizujte položky do kategorií a přeuspořádejte pomocí drag & drop."

#: .\core\views.py:156
msgid "Mark items as out of stock and hide or show sections by schedule."
msgstr ""
"Označte položky jako vyprodané a skryjte nebo zobrazte sekce podle rozvrhu."

#: .\core\views.py:157
msgid "Send orders to your POS or kitchen display via webhooks or API."
msgstr ""
"Odesílejte objednávky do POS nebo kuchyňského displeje přes webhooks nebo "
"API."

#: .\core\views.py:158
msgid "Menus and checkout are optimized for phones and tablets."
msgstr "Menu a pokladna optimalizované pro telefony a tablety."

#: .\core\views.py:159
msgid "Invite staff with roles: admin, manager, or view-only."
msgstr "Zvěte personál s rolemi: admin, manažer nebo pouze prohlížení."

#: .\core\views.py:160
msgid "Clean design and clear CTAs to maximize add-to-cart and checkout."
msgstr "Čistý design a jasné CTA pro maximalizaci přidání do košíku a nákupu."

#: .\core\views.py:163
msgid "Can I use my own domain?"
msgstr "Můžu použít vlastní doménu?"

#: .\core\views.py:163
msgid ""
"Yes. You can connect a custom domain (e.g. menu.yourrestaurant.com) from the"
" settings panel."
msgstr ""
"Ano. Můžete propojit vlastní doménu (např. menu.vaserestaurace.com) v panelu"
" nastavení."

#: .\core\views.py:164
msgid "Is there a mobile app for staff?"
msgstr "Existuje mobilní aplikace pro personál?"

#: .\core\views.py:164
msgid ""
"The panel is fully responsive; you can use it from any browser. Native apps "
"are on our roadmap."
msgstr ""
"Panel je plně responzivní; použijte ho z jakéhokoli prohlížeče. Nativní "
"aplikace jsou v plánu."

#: .\core\views.py:165
msgid "How do I print QR codes?"
msgstr "Jak vytisknu QR kódy?"

#: .\core\views.py:165
msgid ""
"Generate QR codes from the dashboard and download as PNG or SVG. Print on "
"table tents or stickers."
msgstr ""
"Vytvořte QR kódy z nástěnky a stáhněte jako PNG nebo SVG. Tiskněte na stolní"
" stojánky nebo nálepky."

#: .\core\views.py:166
msgid "Do you integrate with POS?"
msgstr "Integrujete se s POS?"

#: .\core\views.py:166
msgid ""
"We support webhooks and an API so you can push orders to your POS or kitchen"
" display system."
msgstr ""
"Podporujeme webhooks a API pro odesílání objednávek do POS nebo kuchyňského "
"displeje."

#: .\core\views.py:173
msgid "Set up your menu"
msgstr "Nastavte menu"

#: .\core\views.py:173
msgid ""
"Create categories, add dishes with prices and photos, and set availability."
msgstr ""
"Vytvořte kategorie, přidejte jídla s cenami a fotkami a nastavte dostupnost."

#: .\core\views.py:173
msgid "Drag-and-drop reorder, bulk edit, or import from spreadsheet."
msgstr "Přeuspořádání drag & drop, hromadná úprava nebo import z tabulky."

#: .\core\views.py:174
msgid "Generate your QR"
msgstr "Vytvořte svůj QR"

#: .\core\views.py:174
msgid ""
"Print QR codes for each table or area. Customers scan to open your menu."
msgstr ""
"Vytiskněte QR kódy pro každý stůl nebo oblast. Zákazníci naskenují a otevřou"
" menu."

#: .\core\views.py:174
msgid "Download PNG or SVG, print on table tents or stickers."
msgstr "Stáhněte PNG nebo SVG, tiskněte na stolní stojánky nebo nálepky."

#: .\core\views.py:175
msgid "Get online orders"
msgstr "Přijímejte online objednávky"

#: .\core\views.py:175
msgid ""
"Customers browse, add to cart, and checkout. You receive and fulfill orders."
msgstr ""
"Zákazníci prochází, přidávají do košíku a platí. Vy přijímáte a plníte "
"objednávky."

#: .\core\views.py:175
msgid "Optional: connect to POS or kitchen display."
msgstr "Volitelné: připojení k POS nebo kuchyňskému displeji."

#: .\core\views.py:186
msgid "QR menu — customers scan and browse your menu on their phone"
msgstr "QR menu — zákazníci naskenují a prohlížejí menu na telefonu."

#: .\core\views.py:187
msgid "Unlimited menu items and categories"
msgstr "Neomezené položky a kategorie"

#: .\core\views.py:188
msgid "Unlimited QR codes for tables and takeaway"
msgstr "Neomezené QR kódy pro stoly a vyzvednutí"

#: .\core\views.py:189
msgid "Online ordering — guests order and pay from the same link"
msgstr "Online objednávky — hosté objednávají a platí ze stejného odkazu."

#: .\core\views.py:190
msgid "Customizable themes to match your brand"
msgstr "Přizpůsobitelné šablony pro vaši značku"

#: .\core\views.py:191
msgid "Campaigns & discounts (happy hour, daily specials)"
msgstr "Kampaně a slevy (happy hour, denní speciály)"

#: .\core\views.py:192
msgid "Multilingual menu support"
msgstr "Podpora vícejazyčného menu"

#: .\core\views.py:193
msgid "Real-time updates — change prices and availability instantly"
msgstr "Aktualizace v reálném čase — okamžitá změna cen a dostupnosti."

#: .\core\views.py:194
msgid "Basic analytics — see what sells"
msgstr "Základní analytika — zjistěte, co se prodává."

#: .\core\views.py:195
msgid "Email & WhatsApp support"
msgstr "Podpora e-mailem a přes WhatsApp"

#: .\core\views.py:199
msgid "Win more orders"
msgstr "Získejte více objednávek"

#: .\core\views.py:199
msgid ""
"Guests order directly from the QR menu. No waiting for staff—faster turnover"
" and higher revenue."
msgstr ""
"Hosté objednávají přímo z QR menu. Bez čekání na obsluhu — rychlejší obrat a"
" vyšší tržby."

#: .\core\views.py:200
msgid "Look professional"
msgstr "Vypadejte profesionálně"

#: .\core\views.py:200
msgid ""
"A clean digital menu and your own domain build trust. Stand out from "
"competitors still using paper."
msgstr ""
"Čisté digitální menu a vlastní doména budují důvěru. Vyčnívejte oproti "
"konkurenci s papírovými menu."

#: .\core\views.py:201
msgid "One subscription, everything included"
msgstr "Jedno předplatné, vše zahrnuto"

#: .\core\views.py:201
msgid ""
"No per-order fees or hidden costs. One annual fee covers menu, ordering, and"
" support."
msgstr ""
"Bez poplatků za objednávku ani skrytých nákladů. Roční poplatek pokrývá "
"menu, objednávky a podporu."

#: .\core\views.py:202
msgid "Launch in minutes"
msgstr "Spusťte za pár minut"

#: .\core\views.py:202
msgid ""
"Add your dishes, print a QR code, and go live. No IT or design skills "
"needed."
msgstr ""
"Přidejte jídla, vytiskněte QR kód a spusťte. Žádné IT ani designové "
"dovednosti nejsou třeba."

#: .\core\views.py:205
msgid "What is included in the price?"
msgstr "Co je zahrnuto v ceně?"

#: .\core\views.py:205
msgid ""
"Everything: QR menu, online ordering, unlimited items and QR codes, "
"campaigns, custom domain option, themes, and support. One annual "
"subscription, no per-order fees."
msgstr ""
"Vše: QR menu, online objednávky, neomezené položky a QR, kampaně, vlastní "
"doména, šablony a podpora. Jedno roční předplatné bez poplatků za "
"objednávku."

#: .\core\views.py:206
msgid "Is there a free trial?"
msgstr "Existuje bezplatná zkušební verze?"

#: .\core\views.py:206
msgid ""
"Yes. Start with a free trial to build your menu and test ordering. No card "
"required until you go live."
msgstr ""
"Ano. Začněte s bezplatnou zkušební verzí, vytvořte menu a otestujte "
"objednávky. Karta není nutná, dokud nespustíte ostrý provoz."

#: .\core\views.py:207
msgid "Why 19% VAT?"
msgstr "Proč 19% DPH?"

#: .\core\views.py:207
msgid ""
"We are VAT-registered in the EU. If you are in the EU and liable for VAT, a "
"19 percent VAT charge is added at checkout (total €238/year). If you are "
"outside the EU or VAT-exempt, the amount may differ."
msgstr ""
"Jsme registrováni k DPH v EU. V EU s povinností DPH se při platbě přičítá 19"
" % (celkem €238/rok). Mimo EU nebo osvobozeni od DPH může být částka jiná."

#: .\core\views.py:244
msgid "Security check failed. Please reload the page and try again."
msgstr ""
"Bezpečnostní kontrola selhala. Prosím znovu načíst stránku a zkuste to "
"znovu."

#: .\core\views.py:247 .\core\views.py:291
msgid "Thanks. If your message needs a reply, we will contact you."
msgstr "Díky. Pokud vaše zpráva potřebuje odpověď, budeme Vás kontaktovat."

#: .\core\views.py:250
msgid "Security check failed. Please try again."
msgstr "Bezpečnostní kontrola selhala. Prosím, zkuste to znovu."

#: .\core\views.py:259
msgid "Please check the form fields and try again."
msgstr "Zkontrolujte prosím pole formuláře a zkuste to znovu."

#: .\core\views.py:262
msgid "Please complete all fields."
msgstr "Prosím, vyplňte všechna pole."

#: .\core\views.py:267
msgid "Too many messages. Please try again later."
msgstr "Příliš mnoho zpráv. Prosím, zkuste to později."

#: .\core\views.py:270
msgid "Please wait before sending another message."
msgstr "Prosím počkejte, než pošlete další zprávu."

#: .\core\views.py:298 .\templates\partials\navbar.html:47
msgid "AI Menu Import"
msgstr "AI Import Menu"

#: .\core\views.py:299
msgid "Turn paper menus into digital menus in minutes."
msgstr "Přeměňte papírová menu na digitální za pár minut."

#: .\core\views.py:300
msgid ""
"Upload a photo or PDF and let AI extract dish names, descriptions, and "
"prices automatically."
msgstr ""
"Nahrajte fotografii nebo PDF a AI automaticky vytáhne názvy, popisy a ceny."

#: .\core\views.py:303
msgid "Save hours of manual typing"
msgstr "Ušetřete hodiny ručního zadávání"

#: .\core\views.py:304
msgid "Launch your QR menu faster"
msgstr "Spusťte QR menu rychleji"

#: .\core\views.py:305
msgid "Reduce human data-entry errors"
msgstr "Snížení lidských chyb při zadávání"

#: .\core\views.py:310 .\templates\partials\navbar.html:48
msgid "Customizable Themes"
msgstr "Přizpůsobitelné šablony"

#: .\core\views.py:311
msgid "Match your menu design to your restaurant brand."
msgstr "Sladění designu menu s brandem restaurace."

#: .\core\views.py:312
msgid ""
"Choose from modern themes and customize colors, typography, and layout in a "
"few clicks."
msgstr ""
"Vyberte moderní šablonu a přizpůsobte barvy, typografii a rozvržení pár "
"kliknutími."

#: .\core\views.py:315
msgid "Consistent brand identity"
msgstr "Konzistentní identita značky"

#: .\core\views.py:316
msgid "Better visual experience for guests"
msgstr "Lepší vizuální zážitek pro hosty"

#: .\core\views.py:317
msgid "Faster edits with pre-built styles"
msgstr "Rychlejší úpravy s předpřipravenými styly"

#: .\core\views.py:322 .\templates\partials\navbar.html:49
msgid "Dedicated Support"
msgstr "Vyhrazená podpora"

#: .\core\views.py:323
msgid "Real help when you need it most."
msgstr "Skutečná pomoc, když ji nejvíc potřebujete."

#: .\core\views.py:324
msgid ""
"Our team helps with setup, menu updates, and optimization so your staff can "
"focus on service."
msgstr ""
"Náš tým pomáhá s nastavením, aktualizacemi menu a optimalizací, aby se "
"personál mohl soustředit na obsluhu."

#: .\core\views.py:327
msgid "Priority support for urgent issues"
msgstr "Prioritní podpora pro naléhavé problémy"

#: .\core\views.py:328
msgid "Faster onboarding for new branches"
msgstr "Rychlejší nasazení nových poboček"

#: .\core\views.py:329
msgid "Better uptime and smoother operations"
msgstr "Vyšší uptime a hladší provoz"

#: .\core\views.py:334 .\templates\partials\navbar.html:50
msgid "Menu Creation"
msgstr "Vytvoření menu"

#: .\core\views.py:335
msgid "Build clean, organized menus your guests love."
msgstr ""
"Vytvořte přehledná a organizovaná menu, která budou vaši hosté milovat."

#: .\core\views.py:336
msgid ""
"Create categories, add dish photos, set prices, and reorder items with a "
"simple dashboard."
msgstr ""
"Vytvořte kategorie, přidejte fotky jídel, nastavte ceny a přeuspořádejte "
"položky v jednoduché nástěnce."

#: .\core\views.py:339
msgid "Unlimited menu items"
msgstr "Neomezené položky menu"

#: .\core\views.py:340
msgid "Quick editing for daily changes"
msgstr "Rychlé úpravy pro každodenní změny"

#: .\core\views.py:341
msgid "Clear structure for better ordering"
msgstr "Přehledná struktura pro lepší objednávky"

#: .\core\views.py:346 .\templates\partials\navbar.html:51
msgid "Multi-Service Management"
msgstr "Správa více služeb"

#: .\core\views.py:347
msgid "Run dine-in, takeaway, and delivery from one panel."
msgstr "Spravujte v restauraci, vyzvednutí a doručení z jednoho panelu."

#: .\core\views.py:348
msgid ""
"Manage service types, availability, and order flow in one place without "
"switching tools."
msgstr ""
"Spravujte typy služeb, dostupnost a tok objednávek na jednom místě, bez "
"přepínání nástrojů."

#: .\core\views.py:351
msgid "One dashboard for all channels"
msgstr "Jedna nástěnka pro všechny kanály"

#: .\core\views.py:352
msgid "Less staff confusion"
msgstr "Menší zmatek pro personál"

#: .\core\views.py:353
msgid "Higher operational speed"
msgstr "Vyšší provozní rychlost"

#: .\core\views.py:358 .\templates\partials\navbar.html:52
msgid "Multilingual Support"
msgstr "Vícejazyčná podpora"

#: .\core\views.py:359
msgid "Serve local and international guests better."
msgstr "Lépe obsluhujte místní i mezinárodní hosty."

#: .\core\views.py:360
msgid ""
"Offer your menu in multiple languages and let customers switch language "
"instantly."
msgstr "Nabídněte menu ve více jazycích a zákazníci hned přepnou."

#: .\core\views.py:363
msgid "Better guest experience for tourists"
msgstr "Lepší zážitek pro turisty"

#: .\core\views.py:364
msgid "Fewer ordering mistakes"
msgstr "Méně chyb v objednávkách"

#: .\core\views.py:365
msgid "Higher conversion on the menu page"
msgstr "Vyšší konverze na stránce menu"

#: .\core\views.py:370 .\templates\partials\navbar.html:53
msgid "Online Ordering"
msgstr "Online objednávky"

#: .\core\views.py:371
msgid "Take orders directly from the QR menu."
msgstr "Přijímejte objednávky přímo z QR menu."

#: .\core\views.py:372
msgid ""
"Guests browse, add to cart, and checkout from their phone with a smooth "
"mobile-first flow."
msgstr ""
"Hosté procházejí, přidávají do košíku a platí z telefonu s hladkým mobile-"
"first tokem."

#: .\core\views.py:375
msgid "Increase average order value"
msgstr "Zvyšte průměrnou hodnotu objednávky"

#: .\core\views.py:376
msgid "Reduce table waiting time"
msgstr "Zkraťte čekání u stolu"

#: .\core\views.py:377
msgid "Capture more takeaway orders"
msgstr "Získejte více objednávek na vyzvednutí"

#: .\core\views.py:382 .\templates\partials\navbar.html:54
msgid "PDF Export"
msgstr "Export do PDF"

#: .\core\views.py:383
msgid "Keep digital and printed menus in sync."
msgstr "Udržujte digitální a tištěná menu synchronizovaná."

#: .\core\views.py:384
msgid ""
"Export your latest menu as PDF for table cards, flyers, and offline sharing."
msgstr ""
"Exportujte poslední menu jako PDF pro stolní kartičky, letáky a offline "
"sdílení."

#: .\core\views.py:387
msgid "Ready-to-print output"
msgstr "Výstup připravený k tisku"

#: .\core\views.py:388
msgid "Consistent branding across channels"
msgstr "Konzistentní branding napříč kanály"

#: .\core\views.py:389
msgid "Simple backup of menu data"
msgstr "Jednoduché zálohování dat menu"

#: .\core\views.py:394 .\templates\partials\navbar.html:55
msgid "Real-Time Updates"
msgstr "Aktualizace v reálném čase"

#: .\core\views.py:395
msgid "Update prices and stock instantly."
msgstr "Aktualizujte ceny a zásoby okamžitě."

#: .\core\views.py:396
msgid ""
"Publish menu changes live in seconds so guests always see accurate "
"information."
msgstr ""
"Publikujte změny menu do sekund, aby hosté vždy viděli přesné informace."

#: .\core\views.py:399
msgid "No stale menu data"
msgstr "Žádná zastaralá menu data"

#: .\core\views.py:400
msgid "Fewer customer complaints"
msgstr "Méně stížností zákazníků"

#: .\core\views.py:401
msgid "Faster reaction to peak-hour demand"
msgstr "Rychlejší reakce na špičkovou poptávku"

#: .\core\views.py:406 .\templates\partials\navbar.html:56
msgid "Secure Payment Processing"
msgstr "Bezpečné zpracování plateb"

#: .\core\views.py:407
msgid "Accept payments safely and confidently."
msgstr "Přijímejte platby bezpečně a s důvěrou."

#: .\core\views.py:408
msgid ""
"Support secure online checkout with trusted gateways and encrypted "
"transaction flow."
msgstr ""
"Podporujte bezpečné online platby s důvěryhodnými bránami a šifrovaným tokem"
" transakcí."

#: .\core\views.py:411
msgid "Safer transactions"
msgstr "Bezpečnější transakce"

#: .\core\views.py:412
msgid "More trust from customers"
msgstr "Vyšší důvěra zákazníků"

#: .\core\views.py:413
msgid "Higher checkout completion"
msgstr "Vyšší dokončení nákupu"

#: .\core\views.py:418 .\templates\partials\navbar.html:57
msgid "Smart Order Management"
msgstr "Chytrá správa objednávek"

#: .\core\views.py:419
msgid "Track every order in one clean queue."
msgstr "Sledujte každou objednávku v jedné přehledné frontě."

#: .\core\views.py:420
msgid ""
"Filter by status, prioritize prep, and keep front-of-house and kitchen fully"
" synchronized."
msgstr ""
"Filtrujte podle stavu, prioritizujte přípravu a mějte přední část a kuchyň "
"synchronizované."

#: .\core\views.py:423
msgid "Clear workflow for staff"
msgstr "Přehledný workflow pro personál"

#: .\core\views.py:424
msgid "Faster fulfillment"
msgstr "Rychlejší vyřízení"

#: .\core\views.py:425
msgid "Improved customer satisfaction"
msgstr "Vyšší spokojenost zákazníků"

#: .\templates\admin\business_menu_section.html:11
