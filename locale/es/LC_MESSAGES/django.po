#: .\core\views.py:106
msgid "Owner, Basil House"
msgstr "Propietaria, Basil House"

#: .\core\views.py:106
msgid "We increased table turnover with faster ordering."
msgstr "Aumentamos la rotación de mesas con pedidos más rápidos."

#: .\core\views.py:107
msgid "Manager, South Fork"
msgstr "Gerente, South Fork"

#: .\core\views.py:107
msgid "Campaigns helped us fill off-peak hours."
msgstr "Las campañas nos ayudaron a llenar las horas valle."

#: .\core\views.py:108
msgid "Founder, Luna Cafe"
msgstr "Fundadora, Luna Cafe"

#: .\core\views.py:108
msgid "Our staff now spends less time taking manual orders."
msgstr "Nuestro personal ahora dedica menos tiempo a tomar pedidos manuales."

#: .\core\views.py:111 .\core\views.py:133
