msgstr "Nuestro equipo ayuda con la configuración, las actualizaciones del menú y la optimización para que tu personal se centre en el servicio."

#: .\core\views.py:240
msgid "Priority support for urgent issues"
msgstr "Soporte prioritario para incidencias urgentes"

#: .\core\views.py:241
msgid "Faster onboarding for new branches"
