msgstr "Gestion intelligente des commandes"

#: .\core\views.py:419
msgid "Track every order in one clean queue."
msgstr "Suivez chaque commande dans une file d'attente claire."

#: .\core\views.py:420
msgid ""
"Filter by status, prioritize prep, and keep front-of-house and kitchen fully"
" synchronized."
msgstr ""
"Filtrez par statut, priorisez la préparation et gardez salle et cuisine "
"parfaitement synchronisées."

#: .\core\views.py:423
msgid "Clear workflow for staff"
msgstr "Flux de travail clair pour le personnel"

#: .\core\views.py:424
msgid "Faster fulfillment"
msgstr "Exécution plus rapide"

#: .\core\views.py:425
msgid "Improved customer satisfaction"
msgstr "Meilleure satisfaction client"

