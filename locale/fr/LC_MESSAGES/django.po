msgid "Turn paper menus into digital menus in minutes."
msgstr "Transformez les menus papier en menus numériques en minutes."

#: .\core\views.py:300
msgid ""
"Upload a photo or PDF and let AI extract dish names, descriptions, and "
"prices automatically."
msgstr ""
"Téléchargez une photo ou un PDF et laissez l'IA extraire automatiquement "
"noms, descriptions et prix."

#: .\core\views.py:303
msgid "Save hours of manual typing"
msgstr "Économisez des heures de saisie manuelle"

#: .\core\views.py:304
msgid "Launch your QR menu faster"
msgstr "Lancez plus vite votre menu QR"

#: .\core\views.py:305
msgid "Reduce human data-entry errors"
msgstr "Réduisez les erreurs de saisie humaine"

#: .\core\views.py:310 .\templates\partials\navbar.html:48
msgid "Customizable Themes"
msgstr "Thèmes personnalisables"

#: .\core\views.py:311
msgid "Match your menu design to your restaurant brand."
msgstr "Alignez le design de votre menu sur votre marque."

#: .\core\views.py:312
msgid ""
"Choose from modern themes and customize colors, typography, and layout in a "
"few clicks."
msgstr ""
"Choisissez parmi des thèmes modernes et personnalisez couleurs, typographie "
"et mise en page en quelques clics."

#: .\core\views.py:315
msgid "Consistent brand identity"
msgstr "Identité de marque cohérente"

#: .\core\views.py:316
msgid "Better visual experience for guests"
msgstr "Meilleure expérience visuelle pour les clients"

#: .\core\views.py:317
msgid "Faster edits with pre-built styles"
msgstr "Modifications plus rapides avec des styles prêts"

#: .\core\views.py:322 .\templates\partials\navbar.html:49
