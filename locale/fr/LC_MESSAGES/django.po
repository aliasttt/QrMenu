msgstr "Recevez les commandes directement depuis le menu QR."

#: .\core\views.py:285
msgid ""
"Guests browse, add to cart, and checkout from their phone with a smooth "
"mobile-first flow."
msgstr "Les clients parcourent, ajoutent au panier et paient depuis leur téléphone avec un parcours mobile-first fluide."

#: .\core\views.py:288
msgid "Increase average order value"
msgstr "Augmentez le panier moyen"

#: .\core\views.py:289
msgid "Reduce table waiting time"
msgstr "Réduisez le temps d'attente à table"

#: .\core\views.py:290
msgid "Capture more takeaway orders"
