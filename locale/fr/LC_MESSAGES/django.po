#: .\core\views.py:106
msgid "Owner, Basil House"
msgstr "Propriétaire, Basil House"

#: .\core\views.py:106
msgid "We increased table turnover with faster ordering."
msgstr "Nous avons augmenté le taux de rotation des tables grâce à des commandes plus rapides."

#: .\core\views.py:107
msgid "Manager, South Fork"
msgstr "Manager, South Fork"

#: .\core\views.py:107
msgid "Campaigns helped us fill off-peak hours."
msgstr "Les campagnes nous ont aidés à remplir les heures creuses."

#: .\core\views.py:108
msgid "Founder, Luna Cafe"
msgstr "Fondatrice, Luna Cafe"

#: .\core\views.py:108
msgid "Our staff now spends less time taking manual orders."
msgstr "Notre personnel passe désormais moins de temps à prendre les commandes manuellement."

