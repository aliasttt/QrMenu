msgstr "Traitement sécurisé des paiements"

#: .\core\views.py:407
msgid "Accept payments safely and confidently."
msgstr "Acceptez les paiements en toute sécurité et en confiance."

#: .\core\views.py:408
msgid ""
"Support secure online checkout with trusted gateways and encrypted "
"transaction flow."
msgstr ""
"Prend en charge un paiement en ligne sécurisé avec des passerelles fiables "
"et un flux chiffré."

#: .\core\views.py:411
msgid "Safer transactions"
msgstr "Transactions plus sûres"

#: .\core\views.py:412
msgid "More trust from customers"
msgstr "Plus de confiance des clients"

#: .\core\views.py:413
msgid "Higher checkout completion"
msgstr "Taux d'achèvement de paiement plus élevé"

#: .\core\views.py:418 .\templates\partials\navbar.html:57
