msgstr "Support dédié"

#: .\core\views.py:323
msgid "Real help when you need it most."
msgstr "Une aide réelle quand vous en avez le plus besoin."

#: .\core\views.py:324
msgid ""
"Our team helps with setup, menu updates, and optimization so your staff can "
"focus on service."
msgstr ""
"Notre équipe vous aide à la mise en place, aux mises à jour de menu et à "
"l'optimisation pour que votre personnel se concentre sur le service."

#: .\core\views.py:327
msgid "Priority support for urgent issues"
msgstr "Support prioritaire pour les urgences"

#: .\core\views.py:328
msgid "Faster onboarding for new branches"
msgstr "Intégration plus rapide des nouvelles succursales"

#: .\core\views.py:329
msgid "Better uptime and smoother operations"
msgstr "Meilleure disponibilité et opérations plus fluides"

#: .\core\views.py:334 .\templates\partials\navbar.html:50
msgid "Menu Creation"
msgstr "Création de menu"

#: .\core\views.py:335
msgid "Build clean, organized menus your guests love."
msgstr "Créez des menus clairs et organisés que vos clients adoreront."

#: .\core\views.py:336
msgid ""
"Create categories, add dish photos, set prices, and reorder items with a "
"simple dashboard."
msgstr ""
"Créez des catégories, ajoutez des photos de plats, définissez les prix et "
"réordonnez les articles depuis un tableau de bord simple."

#: .\core\views.py:339
msgid "Unlimited menu items"
msgstr "Articles illimités"

#: .\core\views.py:340
msgid "Quick editing for daily changes"
msgstr "Édition rapide pour les changements quotidiens"

#: .\core\views.py:341
msgid "Clear structure for better ordering"
msgstr "Structure claire pour de meilleures commandes"

#: .\core\views.py:346 .\templates\partials\navbar.html:51
msgid "Multi-Service Management"
msgstr "Gestion multi-services"

#: .\core\views.py:347
msgid "Run dine-in, takeaway, and delivery from one panel."
msgstr "Gérez sur place, à emporter et livraison depuis un seul panneau."

#: .\core\views.py:348
msgid ""
"Manage service types, availability, and order flow in one place without "
"switching tools."
msgstr ""
"Gérez types de service, disponibilité et flux de commandes au même endroit, "
"sans changer d'outil."

#: .\core\views.py:351
msgid "One dashboard for all channels"
msgstr "Un tableau de bord pour tous les canaux"

#: .\core\views.py:352
msgid "Less staff confusion"
msgstr "Moins de confusion pour le personnel"

#: .\core\views.py:353
msgid "Higher operational speed"
msgstr "Vitesse opérationnelle accrue"

#: .\core\views.py:358 .\templates\partials\navbar.html:52
msgid "Multilingual Support"
msgstr "Support multilingue"

#: .\core\views.py:359
msgid "Serve local and international guests better."
msgstr "Servez mieux les clients locaux et internationaux."

#: .\core\views.py:360
msgid ""
"Offer your menu in multiple languages and let customers switch language "
"instantly."
msgstr ""
"Proposez votre menu en plusieurs langues et laissez les clients changer "
"instantanément."

#: .\core\views.py:363
msgid "Better guest experience for tourists"
msgstr "Meilleure expérience pour les touristes"

#: .\core\views.py:364
msgid "Fewer ordering mistakes"
msgstr "Moins d'erreurs de commande"

#: .\core\views.py:365
msgid "Higher conversion on the menu page"
msgstr "Conversion plus élevée sur la page menu"

#: .\core\views.py:370 .\templates\partials\navbar.html:53
msgid "Online Ordering"
msgstr "Commande en ligne"

#: .\core\views.py:371
msgid "Take orders directly from the QR menu."
msgstr "Recevez les commandes directement depuis le menu QR."

#: .\core\views.py:372
msgid ""
"Guests browse, add to cart, and checkout from their phone with a smooth "
"mobile-first flow."
msgstr ""
"Les clients parcourent, ajoutent au panier et paient depuis leur téléphone "
"avec un parcours mobile-first fluide."

#: .\core\views.py:375
msgid "Increase average order value"
msgstr "Augmentez le panier moyen"

#: .\core\views.py:376
msgid "Reduce table waiting time"
msgstr "Réduisez le temps d'attente à table"

#: .\core\views.py:377
msgid "Capture more takeaway orders"
msgstr "Capturez plus de commandes à emporter"

#: .\core\views.py:382 .\templates\partials\navbar.html:54
msgid "PDF Export"
msgstr "Export PDF"

#: .\core\views.py:383
msgid "Keep digital and printed menus in sync."
msgstr "Synchronisez les menus numériques et imprimés."

#: .\core\views.py:384
msgid ""
"Export your latest menu as PDF for table cards, flyers, and offline sharing."
msgstr ""
"Exportez votre dernier menu en PDF pour cartes de table, flyers et partage "
"hors ligne."

#: .\core\views.py:387
msgid "Ready-to-print output"
msgstr "Sortie prête à imprimer"

#: .\core\views.py:388
msgid "Consistent branding across channels"
msgstr "Image de marque cohérente sur tous les canaux"

#: .\core\views.py:389
msgid "Simple backup of menu data"
msgstr "Sauvegarde simple des données de menu"

#: .\core\views.py:394 .\templates\partials\navbar.html:55
msgid "Real-Time Updates"
msgstr "Mises à jour en temps réel"

#: .\core\views.py:395
msgid "Update prices and stock instantly."
msgstr "Mettez à jour prix et stock instantanément."

#: .\core\views.py:396
msgid ""
"Publish menu changes live in seconds so guests always see accurate "
"information."
msgstr ""
"Publiez les changements de menu en secondes pour que les clients voient "
"toujours les bonnes infos."

#: .\core\views.py:399
msgid "No stale menu data"
msgstr "Aucune donnée de menu obsolète"

#: .\core\views.py:400
msgid "Fewer customer complaints"
msgstr "Moins de plaintes clients"

#: .\core\views.py:401
msgid "Faster reaction to peak-hour demand"
msgstr "Réaction plus rapide à la demande aux heures de pointe"

#: .\core\views.py:406 .\templates\partials\navbar.html:56
