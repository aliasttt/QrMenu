#: .\core\views.py:308
msgid "Update prices and stock instantly."
msgstr "Mettez à jour prix et stock instantanément."

#: .\core\views.py:309
msgid ""
"Publish menu changes live in seconds so guests always see accurate "
"information."
msgstr "Publiez les changements de menu en secondes pour que les clients voient toujours les bonnes infos."

#: .\core\views.py:312
msgid "No stale menu data"
msgstr "Aucune donnée de menu obsolète"

#: .\core\views.py:313
msgid "Fewer customer complaints"
msgstr "Moins de plaintes clients"

#: .\core\views.py:314
msgid "Faster reaction to peak-hour demand"
msgstr "Réaction plus rapide à la demande aux heures de pointe"

#: .\core\views.py:319 .\templates\partials\navbar.html:56
