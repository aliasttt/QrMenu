msgstr "Choisissez parmi des thèmes modernes et personnalisez couleurs, typographie et mise en page en quelques clics."

#: .\core\views.py:228
msgid "Consistent brand identity"
msgstr "Identité de marque cohérente"

#: .\core\views.py:229
msgid "Better visual experience for guests"
msgstr "Meilleure expérience visuelle pour les clients"

#: .\core\views.py:230
msgid "Faster edits with pre-built styles"
msgstr "Modifications plus rapides avec des styles prêts"

#: .\core\views.py:235 .\templates\partials\navbar.html:49
msgid "Dedicated Support"
msgstr "Support dédié"

#: .\core\views.py:236
msgid "Real help when you need it most."
msgstr "Une aide réelle quand vous en avez le plus besoin."

#: .\core\views.py:237
msgid ""
"Our team helps with setup, menu updates, and optimization so your staff can "
"focus on service."
msgstr "Notre équipe vous aide à la mise en place, aux mises à jour de menu et à l'optimisation pour que votre personnel se concentre sur le service."

#: .\core\views.py:240
msgid "Priority support for urgent issues"
msgstr "Support prioritaire pour les urgences"

#: .\core\views.py:241
msgid "Faster onboarding for new branches"
msgstr "Intégration plus rapide des nouvelles succursales"

#: .\core\views.py:242
msgid "Better uptime and smoother operations"
msgstr "Meilleure disponibilité et opérations plus fluides"

