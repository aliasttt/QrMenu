#: .\core\views.py:122
msgid "Owner, Basil House"
msgstr "مالكة، بازل هاوس"

#: .\core\views.py:122
msgid "We increased table turnover with faster ordering."
msgstr "زدنا معدل دوران الطاولات مع طلبات أسرع."

#: .\core\views.py:123
msgid "Manager, South Fork"
msgstr "مدير، ساوث فورك"

#: .\core\views.py:123
msgid "Campaigns helped us fill off-peak hours."
msgstr "ساعدتنا الحملات على ملء ساعات الذروة المنخفضة."

#: .\core\views.py:124
msgid "Founder, Luna Cafe"
msgstr "المؤسسة، لونا كافيه"

#: .\core\views.py:124
msgid "Our staff now spends less time taking manual orders."
msgstr "يقضي موظفونا الآن وقتًا أقل في أخذ الطلبات يدويًا."

#: .\core\views.py:127 .\core\views.py:149
msgid "AI menu import"
msgstr "استيراد القائمة بالذكاء الاصطناعي"

#: .\core\views.py:128 .\core\views.py:150
msgid "Multilingual menus"
msgstr "قوائم متعددة اللغات"

#: .\core\views.py:129 .\core\views.py:151
msgid "QR code generation"
msgstr "إنشاء رموز QR"

#: .\core\views.py:130 .\core\views.py:152
msgid "Order management"
msgstr "إدارة الطلبات"

#: .\core\views.py:131 .\core\views.py:153
msgid "Campaign engine"
msgstr "محرك الحملات"

#: .\core\views.py:132 .\core\views.py:154
msgid "Daily analytics"
msgstr "التحليلات اليومية"

#: .\core\views.py:133 .\core\views.py:155
msgid "Category controls"
msgstr "التحكم بالفئات"

#: .\core\views.py:134 .\core\views.py:156
msgid "Live availability"
msgstr "التوفر المباشر"

#: .\core\views.py:135 .\core\views.py:157
msgid "POS-ready payloads"
msgstr "بيانات جاهزة لنظام POS"

#: .\core\views.py:136 .\core\views.py:158
msgid "Mobile-first pages"
msgstr "صفحات مصممة للجوال أولاً"

#: .\core\views.py:137 .\core\views.py:159
msgid "Role-ready panel"
msgstr "لوحة جاهزة للأدوار"

#: .\core\views.py:138 .\core\views.py:160
msgid "Conversion focused UI"
msgstr "واجهة تركز على التحويل"

#: .\core\views.py:149
msgid ""
"Upload a PDF or photo and we extract your dishes and prices automatically."
msgstr "ارفع ملف PDF أو صورة وسنستخرج أطباقك وأسعارك تلقائياً."

#: .\core\views.py:150
msgid ""
"Serve your menu in multiple languages and switch by customer preference."
msgstr "قدّم قائمتك بعدة لغات وبدّلها حسب تفضيل العميل."

#: .\core\views.py:151
msgid "Generate and download QR codes for tables, takeaway, and delivery."
msgstr "أنشئ وحمّل رموز QR للطاولات والاستلام والتوصيل."

#: .\core\views.py:152
msgid ""
"Receive, track, and fulfill orders from one dashboard with status updates."
msgstr "استقبل الطلبات وتتبعها ونفّذها من لوحة واحدة مع تحديثات الحالة."

#: .\core\views.py:153
msgid ""
"Create time-based discounts, happy hours, and target specific categories."
msgstr "أنشئ تخفيضات محددة بالوقت والساعات السعيدة واستهدف فئات معينة."

#: .\core\views.py:154
msgid "View orders, revenue, and top items with simple charts and exports."
msgstr ""
"اطّلع على الطلبات والإيرادات وأفضل المنتجات مع رسوم بيانية وتصدير بسيط."

#: .\core\views.py:155
msgid "Organize items into categories and reorder with drag-and-drop."
msgstr "نظّم العناصر في فئات وأعد ترتيبها بالسحب والإفلات."

#: .\core\views.py:156
msgid "Mark items as out of stock and hide or show sections by schedule."
msgstr "علّم العناصر بأنها نفدت، وأخفِ الأقسام أو أظهرها حسب الجدول."

#: .\core\views.py:157
msgid "Send orders to your POS or kitchen display via webhooks or API."
msgstr "أرسل الطلبات إلى نظام POS أو شاشة المطبخ عبر webhooks أو API."

#: .\core\views.py:158
msgid "Menus and checkout are optimized for phones and tablets."
msgstr "القوائم والدفع مُحسّنة للهواتف والأجهزة اللوحية."

#: .\core\views.py:159
msgid "Invite staff with roles: admin, manager, or view-only."
msgstr "ادعُ الموظفين بأدوار: مسؤول، مدير أو عرض فقط."

#: .\core\views.py:160
msgid "Clean design and clear CTAs to maximize add-to-cart and checkout."
msgstr "تصميم نظيف وأزرار واضحة لتعظيم إضافة السلة وإتمام الشراء."

#: .\core\views.py:163
msgid "Can I use my own domain?"
msgstr "هل يمكنني استخدام نطاقي الخاص؟"

#: .\core\views.py:163
msgid ""
"Yes. You can connect a custom domain (e.g. menu.yourrestaurant.com) from the"
" settings panel."
msgstr ""
"نعم. يمكنك ربط نطاق مخصص (مثل menu.yourrestaurant.com) من لوحة الإعدادات."

#: .\core\views.py:164
msgid "Is there a mobile app for staff?"
msgstr "هل هناك تطبيق جوال للموظفين؟"

#: .\core\views.py:164
msgid ""
"The panel is fully responsive; you can use it from any browser. Native apps "
"are on our roadmap."
msgstr ""
"اللوحة متجاوبة بالكامل ويمكن استخدامها من أي متصفح. التطبيقات الأصلية ضمن "
"خارطة الطريق."

#: .\core\views.py:165
msgid "How do I print QR codes?"
msgstr "كيف أطبع رموز QR؟"

#: .\core\views.py:165
msgid ""
"Generate QR codes from the dashboard and download as PNG or SVG. Print on "
"table tents or stickers."
msgstr ""
"أنشئ رموز QR من لوحة التحكم وحمّلها بصيغة PNG أو SVG. اطبعها على بطاقات "
"الطاولة أو الملصقات."

#: .\core\views.py:166
msgid "Do you integrate with POS?"
msgstr "هل تتكاملون مع نظام POS؟"

#: .\core\views.py:166
msgid ""
"We support webhooks and an API so you can push orders to your POS or kitchen"
" display system."
msgstr ""
"نحن ندعم webhooks وواجهة برمجية لإرسال الطلبات إلى نظام POS أو شاشة المطبخ."

#: .\core\views.py:173
msgid "Set up your menu"
msgstr "أعد قائمتك"

#: .\core\views.py:173
msgid ""
"Create categories, add dishes with prices and photos, and set availability."
msgstr "أنشئ الفئات وأضف الأطباق مع الأسعار والصور، وحدد التوفر."

#: .\core\views.py:173
msgid "Drag-and-drop reorder, bulk edit, or import from spreadsheet."
msgstr "أعد الترتيب بالسحب والإفلات، حرّر بالجملة أو استورد من جدول بيانات."

#: .\core\views.py:174
msgid "Generate your QR"
msgstr "أنشئ QR الخاص بك"

#: .\core\views.py:174
msgid ""
"Print QR codes for each table or area. Customers scan to open your menu."
msgstr "اطبع رموز QR لكل طاولة أو منطقة. يمسحها العملاء لفتح قائمتك."

#: .\core\views.py:174
msgid "Download PNG or SVG, print on table tents or stickers."
msgstr "حمّل بصيغة PNG أو SVG واطبع على بطاقات الطاولة أو الملصقات."

#: .\core\views.py:175
msgid "Get online orders"
msgstr "احصل على طلبات عبر الإنترنت"

#: .\core\views.py:175
msgid ""
"Customers browse, add to cart, and checkout. You receive and fulfill orders."
msgstr ""
"يتصفح العملاء ويضيفون إلى السلة ويتممون الدفع. أنت تستقبل الطلبات وتنفّذها."

#: .\core\views.py:175
msgid "Optional: connect to POS or kitchen display."
msgstr "اختياري: الاتصال بنظام POS أو شاشة المطبخ."

#: .\core\views.py:186
msgid "QR menu — customers scan and browse your menu on their phone"
msgstr "قائمة QR — يمسحها العملاء ويتصفحون قائمتك على هواتفهم."

#: .\core\views.py:187
msgid "Unlimited menu items and categories"
msgstr "عدد غير محدود من العناصر والفئات"

#: .\core\views.py:188
msgid "Unlimited QR codes for tables and takeaway"
msgstr "رموز QR غير محدودة للطاولات والاستلام"

#: .\core\views.py:189
msgid "Online ordering — guests order and pay from the same link"
msgstr "الطلب عبر الإنترنت — يطلب الضيوف ويدفعون من نفس الرابط."

#: .\core\views.py:190
msgid "Customizable themes to match your brand"
msgstr "قوالب قابلة للتخصيص لتتناسب مع علامتك التجارية"

#: .\core\views.py:191
msgid "Campaigns & discounts (happy hour, daily specials)"
msgstr "حملات وتخفيضات (ساعات سعيدة، عروض اليوم)"

#: .\core\views.py:192
msgid "Multilingual menu support"
msgstr "دعم القائمة بلغات متعددة"

#: .\core\views.py:193
msgid "Real-time updates — change prices and availability instantly"
msgstr "تحديثات فورية — غيّر الأسعار والتوفر بشكل مباشر."

#: .\core\views.py:194
msgid "Basic analytics — see what sells"
msgstr "تحليلات أساسية — اعرف ما الذي يُباع."

#: .\core\views.py:195
msgid "Email & WhatsApp support"
msgstr "دعم عبر البريد الإلكتروني وواتساب"

#: .\core\views.py:199
msgid "Win more orders"
msgstr "احصل على مزيد من الطلبات"

#: .\core\views.py:199
msgid ""
"Guests order directly from the QR menu. No waiting for staff—faster turnover"
" and higher revenue."
msgstr ""
"يطلب الضيوف مباشرة من قائمة QR. لا انتظار للموظف — دوران أسرع وإيرادات أعلى."

#: .\core\views.py:200
msgid "Look professional"
msgstr "ابرز باحتراف"

#: .\core\views.py:200
msgid ""
"A clean digital menu and your own domain build trust. Stand out from "
"competitors still using paper."
msgstr ""
"قائمة رقمية أنيقة ونطاق خاص بك يبنيان الثقة. تميّز عن المنافسين الذين لا "
"يزالون يستخدمون الورق."

#: .\core\views.py:201
msgid "One subscription, everything included"
msgstr "اشتراك واحد يشمل كل شيء"

#: .\core\views.py:201
msgid ""
"No per-order fees or hidden costs. One annual fee covers menu, ordering, and"
" support."
msgstr ""
"لا رسوم لكل طلب ولا تكاليف خفية. رسم سنوي واحد يغطي القائمة والطلبات والدعم."

#: .\core\views.py:202
msgid "Launch in minutes"
msgstr "أطلق خلال دقائق"

#: .\core\views.py:202
msgid ""
"Add your dishes, print a QR code, and go live. No IT or design skills "
"needed."
msgstr "أضف أطباقك، اطبع رمز QR وابدأ البث. لا حاجة لمهارات تقنية أو تصميم."

#: .\core\views.py:205
msgid "What is included in the price?"
msgstr "ماذا يشمل السعر؟"

#: .\core\views.py:205
msgid ""
"Everything: QR menu, online ordering, unlimited items and QR codes, "
"campaigns, custom domain option, themes, and support. One annual "
"subscription, no per-order fees."
msgstr ""
"كل شيء: قائمة QR، الطلب عبر الإنترنت، عناصر ورموز QR غير محدودة، الحملات، "
"خيار النطاق المخصص، القوالب والدعم. اشتراك سنوي واحد بدون رسوم لكل طلب."

#: .\core\views.py:206
msgid "Is there a free trial?"
msgstr "هل هناك نسخة تجريبية مجانية؟"

#: .\core\views.py:206
msgid ""
"Yes. Start with a free trial to build your menu and test ordering. No card "
"required until you go live."
msgstr ""
"نعم. ابدأ بنسخة تجريبية مجانية لبناء قائمتك واختبار الطلبات. لا حاجة لبطاقة "
"حتى تنطلق."

#: .\core\views.py:207
msgid "Why 19% VAT?"
msgstr "لماذا 19% ضريبة قيمة مضافة؟"

#: .\core\views.py:207
msgid ""
"We are VAT-registered in the EU. If you are in the EU and liable for VAT, a "
"19 percent VAT charge is added at checkout (total €238/year). If you are "
"outside the EU or VAT-exempt, the amount may differ."
msgstr ""
"نحن مسجّلون بضريبة القيمة المضافة في الاتحاد الأوروبي. إذا كنت في الاتحاد "
"الأوروبي وخاضعاً للضريبة، تُضاف 19% عند الدفع (بإجمالي €238/سنة). خارج "
"الاتحاد أو المعفيّ قد يختلف المبلغ."

#: .\core\views.py:244
msgid "Security check failed. Please reload the page and try again."
msgstr "تفقد الأمن فشل من فضلك أعد تحميل الصفحة وحاول مرة أخرى"

#: .\core\views.py:247 .\core\views.py:291
msgid "Thanks. If your message needs a reply, we will contact you."
msgstr "شكراً إذا كانت رسالتك تحتاج إلى رد، سنتصل بك."

#: .\core\views.py:250
msgid "Security check failed. Please try again."
msgstr "تفقد الأمن فشل أرجوك حاول مرة أخرى"

#: .\core\views.py:259
msgid "Please check the form fields and try again."
msgstr "يرجى التحقق من حقول الشكل ومحاولة مرة أخرى."

#: .\core\views.py:262
msgid "Please complete all fields."
msgstr "من فضلك أكمل كل الحقول"

#: .\core\views.py:267
msgid "Too many messages. Please try again later."
msgstr "الكثير من الرسائل حاول مرة أخرى لاحقاً"

#: .\core\views.py:270
msgid "Please wait before sending another message."
msgstr "أرجوك انتظر قبل أن ترسل رسالة أخرى"

#: .\core\views.py:298 .\templates\partials\navbar.html:47
msgid "AI Menu Import"
msgstr "استيراد القائمة بالذكاء الاصطناعي"

#: .\core\views.py:299
msgid "Turn paper menus into digital menus in minutes."
msgstr "حوّل قوائم الورق إلى قوائم رقمية خلال دقائق."

#: .\core\views.py:300
msgid ""
"Upload a photo or PDF and let AI extract dish names, descriptions, and "
"prices automatically."
msgstr ""
"ارفع صورة أو ملف PDF ودع الذكاء الاصطناعي يستخرج الأسماء والوصف والأسعار "
"تلقائياً."

#: .\core\views.py:303
msgid "Save hours of manual typing"
msgstr "وفّر ساعات من الإدخال اليدوي"

#: .\core\views.py:304
msgid "Launch your QR menu faster"
msgstr "أطلق قائمة QR بشكل أسرع"

#: .\core\views.py:305
msgid "Reduce human data-entry errors"
msgstr "قلّل أخطاء الإدخال البشرية"

#: .\core\views.py:310 .\templates\partials\navbar.html:48
msgid "Customizable Themes"
msgstr "قوالب قابلة للتخصيص"

#: .\core\views.py:311
msgid "Match your menu design to your restaurant brand."
msgstr "طابق تصميم قائمتك مع علامتك التجارية."

#: .\core\views.py:312
msgid ""
"Choose from modern themes and customize colors, typography, and layout in a "
"few clicks."
msgstr "اختر من قوالب حديثة وخصص الألوان والطباعة والتخطيط ببضع نقرات."

#: .\core\views.py:315
msgid "Consistent brand identity"
msgstr "هوية علامة تجارية متسقة"

#: .\core\views.py:316
msgid "Better visual experience for guests"
msgstr "تجربة بصرية أفضل للضيوف"

#: .\core\views.py:317
msgid "Faster edits with pre-built styles"
msgstr "تعديلات أسرع بأنماط جاهزة"

#: .\core\views.py:322 .\templates\partials\navbar.html:49
msgid "Dedicated Support"
msgstr "دعم مخصص"

#: .\core\views.py:323
msgid "Real help when you need it most."
msgstr "مساعدة حقيقية حين تحتاجها أكثر."

#: .\core\views.py:324
msgid ""
"Our team helps with setup, menu updates, and optimization so your staff can "
"focus on service."
msgstr ""
"يساعدك فريقنا في الإعداد وتحديثات القائمة والتحسين ليتفرغ موظفوك للخدمة."

#: .\core\views.py:327
msgid "Priority support for urgent issues"
msgstr "دعم ذو أولوية للحالات العاجلة"

#: .\core\views.py:328
msgid "Faster onboarding for new branches"
msgstr "تجهيز أسرع للفروع الجديدة"

#: .\core\views.py:329
msgid "Better uptime and smoother operations"
msgstr "توفر أفضل وعمليات أكثر سلاسة"

#: .\core\views.py:334 .\templates\partials\navbar.html:50
msgid "Menu Creation"
msgstr "إنشاء القائمة"

#: .\core\views.py:335
msgid "Build clean, organized menus your guests love."
msgstr "أنشئ قوائم نظيفة ومنظمة يحبها ضيوفك."

#: .\core\views.py:336
msgid ""
"Create categories, add dish photos, set prices, and reorder items with a "
"simple dashboard."
msgstr ""
"أنشئ الفئات، أضف صور الأطباق، حدد الأسعار وأعد ترتيب العناصر بلوحة تحكم "
"بسيطة."

#: .\core\views.py:339
msgid "Unlimited menu items"
msgstr "عناصر قائمة غير محدودة"

#: .\core\views.py:340
msgid "Quick editing for daily changes"
msgstr "تعديل سريع للتغييرات اليومية"

#: .\core\views.py:341
msgid "Clear structure for better ordering"
msgstr "بنية واضحة لطلبات أفضل"

#: .\core\views.py:346 .\templates\partials\navbar.html:51
msgid "Multi-Service Management"
msgstr "إدارة الخدمات المتعددة"

#: .\core\views.py:347
msgid "Run dine-in, takeaway, and delivery from one panel."
msgstr "أدر تناول الطعام والاستلام والتوصيل من لوحة واحدة."

#: .\core\views.py:348
msgid ""
"Manage service types, availability, and order flow in one place without "
"switching tools."
msgstr ""
"أدر أنواع الخدمة والتوفر وتدفق الطلبات في مكان واحد دون تبديل الأدوات."

#: .\core\views.py:351
msgid "One dashboard for all channels"
msgstr "لوحة واحدة لجميع القنوات"

#: .\core\views.py:352
msgid "Less staff confusion"
msgstr "ارتباك أقل للموظفين"

#: .\core\views.py:353
msgid "Higher operational speed"
msgstr "سرعة تشغيل أعلى"

#: .\core\views.py:358 .\templates\partials\navbar.html:52
msgid "Multilingual Support"
msgstr "دعم متعدد اللغات"

#: .\core\views.py:359
msgid "Serve local and international guests better."
msgstr "قدّم خدمة أفضل للضيوف المحليين والدوليين."

#: .\core\views.py:360
msgid ""
"Offer your menu in multiple languages and let customers switch language "
"instantly."
msgstr "قدّم قائمتك بعدة لغات ودَع العملاء يبدّلون اللغة فوراً."

#: .\core\views.py:363
msgid "Better guest experience for tourists"
msgstr "تجربة أفضل للسياح"

#: .\core\views.py:364
msgid "Fewer ordering mistakes"
msgstr "أخطاء أقل في الطلب"

#: .\core\views.py:365
msgid "Higher conversion on the menu page"
msgstr "معدل تحويل أعلى في صفحة القائمة"

#: .\core\views.py:370 .\templates\partials\navbar.html:53
msgid "Online Ordering"
msgstr "الطلب عبر الإنترنت"

#: .\core\views.py:371
msgid "Take orders directly from the QR menu."
msgstr "استقبل الطلبات مباشرة من قائمة QR."

#: .\core\views.py:372
msgid ""
"Guests browse, add to cart, and checkout from their phone with a smooth "
"mobile-first flow."
msgstr ""
"يتصفح الضيوف ويضيفون إلى السلة ويكملون الدفع من الهاتف بتدفق مصمم للجوال "
"أولاً."

#: .\core\views.py:375
msgid "Increase average order value"
msgstr "زيادة متوسط قيمة الطلب"

#: .\core\views.py:376
msgid "Reduce table waiting time"
msgstr "قلّل وقت الانتظار على الطاولة"

#: .\core\views.py:377
msgid "Capture more takeaway orders"
msgstr "استقطب مزيداً من طلبات الاستلام"

#: .\core\views.py:382 .\templates\partials\navbar.html:54
msgid "PDF Export"
msgstr "تصدير PDF"

#: .\core\views.py:383
msgid "Keep digital and printed menus in sync."
msgstr "حافظ على مزامنة القوائم الرقمية والمطبوعة."

#: .\core\views.py:384
msgid ""
"Export your latest menu as PDF for table cards, flyers, and offline sharing."
msgstr "صدّر آخر قائمة كملف PDF لبطاقات الطاولة والنشرات ومشاركة دون اتصال."

#: .\core\views.py:387
msgid "Ready-to-print output"
msgstr "مخرجات جاهزة للطباعة"

#: .\core\views.py:388
msgid "Consistent branding across channels"
