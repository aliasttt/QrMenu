msgstr "Il nostro team ti aiuta con setup, aggiornamenti menu e ottimizzazione, così lo staff si concentra sul servizio."

#: .\core\views.py:240
msgid "Priority support for urgent issues"
msgstr "Supporto prioritario per problemi urgenti"

