#: .\core\views.py:122
msgid "Owner, Basil House"
msgstr "Proprietaria, Basil House"

#: .\core\views.py:122
msgid "We increased table turnover with faster ordering."
msgstr "Abbiamo aumentato la rotazione dei tavoli con ordini più rapidi."

#: .\core\views.py:123
msgid "Manager, South Fork"
msgstr "Responsabile, South Fork"

#: .\core\views.py:123
msgid "Campaigns helped us fill off-peak hours."
msgstr "Le campagne ci hanno aiutato a riempire le ore di scarso afflusso."

#: .\core\views.py:124
msgid "Founder, Luna Cafe"
msgstr "Fondatrice, Luna Cafe"

#: .\core\views.py:124
msgid "Our staff now spends less time taking manual orders."
msgstr ""
"Il nostro personale dedica meno tempo alla presa manuale degli ordini."

#: .\core\views.py:127 .\core\views.py:149
msgid "AI menu import"
msgstr "Importazione menu con IA"

#: .\core\views.py:128 .\core\views.py:150
msgid "Multilingual menus"
msgstr "Menu multilingue"

#: .\core\views.py:129 .\core\views.py:151
msgid "QR code generation"
msgstr "Generazione codici QR"

#: .\core\views.py:130 .\core\views.py:152
msgid "Order management"
msgstr "Gestione ordini"

#: .\core\views.py:131 .\core\views.py:153
msgid "Campaign engine"
msgstr "Motore di campagne"

#: .\core\views.py:132 .\core\views.py:154
msgid "Daily analytics"
msgstr "Analisi giornaliere"

#: .\core\views.py:133 .\core\views.py:155
msgid "Category controls"
msgstr "Controlli categorie"

#: .\core\views.py:134 .\core\views.py:156
msgid "Live availability"
msgstr "Disponibilità in tempo reale"

#: .\core\views.py:135 .\core\views.py:157
msgid "POS-ready payloads"
msgstr "Payload pronti per POS"

#: .\core\views.py:136 .\core\views.py:158
msgid "Mobile-first pages"
msgstr "Pagine mobile-first"

#: .\core\views.py:137 .\core\views.py:159
msgid "Role-ready panel"
msgstr "Pannello con ruoli"

#: .\core\views.py:138 .\core\views.py:160
msgid "Conversion focused UI"
msgstr "UI orientata alla conversione"

#: .\core\views.py:149
msgid ""
"Upload a PDF or photo and we extract your dishes and prices automatically."
msgstr ""
"Carica un PDF o una foto ed estraiamo automaticamente piatti e prezzi."

#: .\core\views.py:150
msgid ""
"Serve your menu in multiple languages and switch by customer preference."
msgstr ""
"Offri il menu in più lingue e cambia in base alle preferenze del cliente."

#: .\core\views.py:151
msgid "Generate and download QR codes for tables, takeaway, and delivery."
msgstr "Genera e scarica codici QR per tavoli, ritiro e consegna."

#: .\core\views.py:152
msgid ""
"Receive, track, and fulfill orders from one dashboard with status updates."
msgstr ""
"Ricevi, traccia e completa gli ordini da un'unica dashboard con "
"aggiornamenti di stato."

#: .\core\views.py:153
msgid ""
"Create time-based discounts, happy hours, and target specific categories."
msgstr "Crea sconti a tempo, happy hour e targeting su categorie specifiche."

#: .\core\views.py:154
msgid "View orders, revenue, and top items with simple charts and exports."
msgstr ""
"Visualizza ordini, ricavi e articoli top con grafici semplici ed "
"esportazioni."

#: .\core\views.py:155
msgid "Organize items into categories and reorder with drag-and-drop."
msgstr "Organizza gli articoli in categorie e riordina con drag & drop."

#: .\core\views.py:156
msgid "Mark items as out of stock and hide or show sections by schedule."
msgstr "Segnala articoli esauriti e nascondi o mostra sezioni per orario."

#: .\core\views.py:157
msgid "Send orders to your POS or kitchen display via webhooks or API."
msgstr "Invia gli ordini al POS o al display cucina tramite webhook o API."

#: .\core\views.py:158
msgid "Menus and checkout are optimized for phones and tablets."
msgstr "Menu e checkout ottimizzati per smartphone e tablet."

#: .\core\views.py:159
msgid "Invite staff with roles: admin, manager, or view-only."
msgstr "Invita il personale con ruoli: admin, manager o solo lettura."

#: .\core\views.py:160
msgid "Clean design and clear CTAs to maximize add-to-cart and checkout."
msgstr ""
"Design pulito e CTA chiari per massimizzare aggiunte al carrello e checkout."

#: .\core\views.py:163
msgid "Can I use my own domain?"
msgstr "Posso usare il mio dominio?"

#: .\core\views.py:163
msgid ""
"Yes. You can connect a custom domain (e.g. menu.yourrestaurant.com) from the"
" settings panel."
msgstr ""
"Sì. Puoi collegare un dominio personalizzato (es. menu.tuoristorante.com) "
"dal pannello impostazioni."

#: .\core\views.py:164
msgid "Is there a mobile app for staff?"
msgstr "C'è un'app mobile per il personale?"

#: .\core\views.py:164
msgid ""
"The panel is fully responsive; you can use it from any browser. Native apps "
"are on our roadmap."
msgstr ""
"Il pannello è completamente responsive; puoi usarlo da qualsiasi browser. Le"
" app native sono nella roadmap."

#: .\core\views.py:165
msgid "How do I print QR codes?"
msgstr "Come stampo i codici QR?"

#: .\core\views.py:165
msgid ""
"Generate QR codes from the dashboard and download as PNG or SVG. Print on "
"table tents or stickers."
msgstr ""
"Genera codici QR dalla dashboard e scaricali come PNG o SVG. Stampa su "
"cartellini o adesivi."

#: .\core\views.py:166
msgid "Do you integrate with POS?"
msgstr "Vi integrate con POS?"

#: .\core\views.py:166
msgid ""
"We support webhooks and an API so you can push orders to your POS or kitchen"
" display system."
msgstr ""
"Supportiamo webhook e un'API per inviare gli ordini al POS o al sistema "
"kitchen display."

#: .\core\views.py:173
msgid "Set up your menu"
msgstr "Configura il tuo menu"

#: .\core\views.py:173
msgid ""
"Create categories, add dishes with prices and photos, and set availability."
msgstr ""
"Crea categorie, aggiungi piatti con prezzi e foto e imposta la "
"disponibilità."

#: .\core\views.py:173
msgid "Drag-and-drop reorder, bulk edit, or import from spreadsheet."
msgstr ""
"Riordina con drag & drop, modifica in blocco o importa da foglio di calcolo."

#: .\core\views.py:174
msgid "Generate your QR"
msgstr "Genera il tuo QR"

#: .\core\views.py:174
msgid ""
"Print QR codes for each table or area. Customers scan to open your menu."
msgstr ""
"Stampa codici QR per ogni tavolo o area. I clienti scansionano per aprire il"
" menu."

#: .\core\views.py:174
msgid "Download PNG or SVG, print on table tents or stickers."
msgstr "Scarica PNG o SVG, stampa su cartellini o adesivi."

#: .\core\views.py:175
msgid "Get online orders"
msgstr "Ricevi ordini online"

#: .\core\views.py:175
msgid ""
"Customers browse, add to cart, and checkout. You receive and fulfill orders."
msgstr ""
"I clienti sfogliano, aggiungono al carrello e pagano. Tu ricevi ed evadi gli"
" ordini."

#: .\core\views.py:175
msgid "Optional: connect to POS or kitchen display."
msgstr "Opzionale: connetti a POS o display cucina."

#: .\core\views.py:186
msgid "QR menu — customers scan and browse your menu on their phone"
msgstr "Menu QR — i clienti scansionano e sfogliano il menu dal telefono."

#: .\core\views.py:187
msgid "Unlimited menu items and categories"
msgstr "Voci e categorie illimitate"

#: .\core\views.py:188
msgid "Unlimited QR codes for tables and takeaway"
msgstr "Codici QR illimitati per tavoli e asporto"

#: .\core\views.py:189
msgid "Online ordering — guests order and pay from the same link"
msgstr "Ordinazione online — gli ospiti ordinano e pagano dallo stesso link."

#: .\core\views.py:190
msgid "Customizable themes to match your brand"
msgstr "Temi personalizzabili in linea con il brand"

#: .\core\views.py:191
msgid "Campaigns & discounts (happy hour, daily specials)"
msgstr "Campagne e sconti (happy hour, offerte del giorno)"

#: .\core\views.py:192
msgid "Multilingual menu support"
msgstr "Supporto menu multilingue"

#: .\core\views.py:193
msgid "Real-time updates — change prices and availability instantly"
msgstr ""
"Aggiornamenti in tempo reale — cambia prezzi e disponibilità all'istante."

#: .\core\views.py:194
msgid "Basic analytics — see what sells"
msgstr "Analisi di base — scopri cosa vende."

#: .\core\views.py:195
msgid "Email & WhatsApp support"
msgstr "Supporto via email e WhatsApp"

#: .\core\views.py:199
msgid "Win more orders"
msgstr "Ottieni più ordini"

#: .\core\views.py:199
msgid ""
"Guests order directly from the QR menu. No waiting for staff—faster turnover"
" and higher revenue."
msgstr ""
"Gli ospiti ordinano direttamente dal menu QR. Niente attese del personale — "
"rotazione più rapida e ricavi maggiori."

#: .\core\views.py:200
msgid "Look professional"
msgstr "Fai bella figura"

#: .\core\views.py:200
msgid ""
"A clean digital menu and your own domain build trust. Stand out from "
"competitors still using paper."
msgstr ""
"Un menu digitale pulito e un dominio dedicato costruiscono fiducia. "
"Distinguiti dai concorrenti che usano ancora il cartaceo."

#: .\core\views.py:201
msgid "One subscription, everything included"
msgstr "Un abbonamento, tutto incluso"

#: .\core\views.py:201
msgid ""
"No per-order fees or hidden costs. One annual fee covers menu, ordering, and"
" support."
msgstr ""
"Nessuna commissione per ordine né costi nascosti. Una quota annuale copre "
"menu, ordini e supporto."

#: .\core\views.py:202
msgid "Launch in minutes"
msgstr "Lancia in pochi minuti"

#: .\core\views.py:202
msgid ""
"Add your dishes, print a QR code, and go live. No IT or design skills "
"needed."
msgstr ""
"Aggiungi i piatti, stampa un QR code e vai online. Nessuna competenza IT o "
"di design."

#: .\core\views.py:205
msgid "What is included in the price?"
msgstr "Cosa è incluso nel prezzo?"

#: .\core\views.py:205
msgid ""
"Everything: QR menu, online ordering, unlimited items and QR codes, "
"campaigns, custom domain option, themes, and support. One annual "
"subscription, no per-order fees."
msgstr ""
"Tutto: menu QR, ordini online, articoli e QR illimitati, campagne, dominio "
"personalizzato, temi e supporto. Un abbonamento annuale, senza commissioni "
"per ordine."

#: .\core\views.py:206
msgid "Is there a free trial?"
msgstr "C'è una prova gratuita?"

#: .\core\views.py:206
msgid ""
"Yes. Start with a free trial to build your menu and test ordering. No card "
"required until you go live."
msgstr ""
"Sì. Inizia con una prova gratuita per creare il menu e testare gli ordini. "
"Nessuna carta richiesta finché non vai online."

#: .\core\views.py:207
msgid "Why 19% VAT?"
msgstr "Perché IVA al 19%?"

#: .\core\views.py:207
msgid ""
"We are VAT-registered in the EU. If you are in the EU and liable for VAT, a "
"19 percent VAT charge is added at checkout (total €238/year). If you are "
"outside the EU or VAT-exempt, the amount may differ."
msgstr ""
"Siamo registrati IVA in UE. Se sei in UE e soggetto a IVA, il 19% viene "
"aggiunto al checkout (totale €238/anno). Fuori UE o esente IVA l'importo può"
" variare."

#: .\core\views.py:244
msgid "Security check failed. Please reload the page and try again."
msgstr ""
"Il controllo di sicurezza e' fallito. Si prega di ricaricare la pagina e "
"riprovare."

#: .\core\views.py:247 .\core\views.py:291
msgid "Thanks. If your message needs a reply, we will contact you."
msgstr ""
"Grazie. Se il tuo messaggio ha bisogno di una risposta, ti contatteremo."

#: .\core\views.py:250
msgid "Security check failed. Please try again."
msgstr "Il controllo di sicurezza e' fallito. Per favore riprovate."

#: .\core\views.py:259
msgid "Please check the form fields and try again."
msgstr "Si prega di controllare i campi del modulo e riprovare."

#: .\core\views.py:262
msgid "Please complete all fields."
msgstr "Si prega di completare tutti i campi."

#: .\core\views.py:267
msgid "Too many messages. Please try again later."
msgstr "Troppi messaggi. Riprova più tardi."

#: .\core\views.py:270
msgid "Please wait before sending another message."
msgstr "Attendere prima di inviare un altro messaggio."

#: .\core\views.py:298 .\templates\partials\navbar.html:47
msgid "AI Menu Import"
msgstr "Importazione menu con IA"

#: .\core\views.py:299
msgid "Turn paper menus into digital menus in minutes."
msgstr "Trasforma i menu cartacei in menu digitali in pochi minuti."

#: .\core\views.py:300
msgid ""
"Upload a photo or PDF and let AI extract dish names, descriptions, and "
"prices automatically."
msgstr ""
"Carica una foto o un PDF e lascia che l'IA estragga automaticamente nomi, "
"descrizioni e prezzi."

#: .\core\views.py:303
msgid "Save hours of manual typing"
msgstr "Risparmia ore di digitazione manuale"

#: .\core\views.py:304
msgid "Launch your QR menu faster"
msgstr "Lancia più velocemente il tuo menu QR"

#: .\core\views.py:305
msgid "Reduce human data-entry errors"
msgstr "Riduci gli errori umani di inserimento"

#: .\core\views.py:310 .\templates\partials\navbar.html:48
msgid "Customizable Themes"
msgstr "Temi personalizzabili"

#: .\core\views.py:311
msgid "Match your menu design to your restaurant brand."
msgstr "Allinea il design del menu al brand del ristorante."

#: .\core\views.py:312
msgid ""
"Choose from modern themes and customize colors, typography, and layout in a "
"few clicks."
msgstr ""
"Scegli fra temi moderni e personalizza colori, tipografia e layout in pochi "
"clic."

#: .\core\views.py:315
msgid "Consistent brand identity"
msgstr "Identità del brand coerente"

#: .\core\views.py:316
msgid "Better visual experience for guests"
msgstr "Miglior esperienza visiva per gli ospiti"

#: .\core\views.py:317
msgid "Faster edits with pre-built styles"
msgstr "Modifiche più rapide con stili predefiniti"

#: .\core\views.py:322 .\templates\partials\navbar.html:49
msgid "Dedicated Support"
msgstr "Supporto dedicato"

#: .\core\views.py:323
msgid "Real help when you need it most."
msgstr "Aiuto reale quando ne hai più bisogno."

#: .\core\views.py:324
msgid ""
"Our team helps with setup, menu updates, and optimization so your staff can "
"focus on service."
msgstr ""
"Il nostro team ti aiuta con setup, aggiornamenti menu e ottimizzazione, così"
" lo staff si concentra sul servizio."

#: .\core\views.py:327
msgid "Priority support for urgent issues"
msgstr "Supporto prioritario per problemi urgenti"

#: .\core\views.py:328
msgid "Faster onboarding for new branches"
msgstr "Onboarding più rapido per nuovi punti vendita"

#: .\core\views.py:329
msgid "Better uptime and smoother operations"
msgstr "Uptime migliore e operatività più fluida"

#: .\core\views.py:334 .\templates\partials\navbar.html:50
msgid "Menu Creation"
msgstr "Creazione menu"

#: .\core\views.py:335
msgid "Build clean, organized menus your guests love."
msgstr "Crea menu puliti e organizzati che i tuoi ospiti adoreranno."

#: .\core\views.py:336
msgid ""
"Create categories, add dish photos, set prices, and reorder items with a "
"simple dashboard."
msgstr ""
"Crea categorie, aggiungi foto dei piatti, imposta prezzi e riordina gli "
"articoli da una dashboard semplice."

#: .\core\views.py:339
msgid "Unlimited menu items"
msgstr "Voci menu illimitate"

#: .\core\views.py:340
msgid "Quick editing for daily changes"
msgstr "Modifica rapida per cambi giornalieri"

#: .\core\views.py:341
msgid "Clear structure for better ordering"
msgstr "Struttura chiara per ordinazioni migliori"

#: .\core\views.py:346 .\templates\partials\navbar.html:51
msgid "Multi-Service Management"
msgstr "Gestione multiservizio"

#: .\core\views.py:347
msgid "Run dine-in, takeaway, and delivery from one panel."
msgstr "Gestisci sala, asporto e consegna da un unico pannello."

#: .\core\views.py:348
msgid ""
"Manage service types, availability, and order flow in one place without "
"switching tools."
msgstr ""
"Gestisci tipi di servizio, disponibilità e flusso ordini in un posto solo, "
"senza cambiare strumento."

#: .\core\views.py:351
msgid "One dashboard for all channels"
msgstr "Un'unica dashboard per tutti i canali"

#: .\core\views.py:352
msgid "Less staff confusion"
msgstr "Meno confusione per lo staff"

#: .\core\views.py:353
msgid "Higher operational speed"
msgstr "Maggior velocità operativa"

#: .\core\views.py:358 .\templates\partials\navbar.html:52
msgid "Multilingual Support"
msgstr "Supporto multilingue"

#: .\core\views.py:359
msgid "Serve local and international guests better."
msgstr "Servi meglio ospiti locali e internazionali."

#: .\core\views.py:360
msgid ""
"Offer your menu in multiple languages and let customers switch language "
"instantly."
msgstr ""
"Offri il menu in più lingue e lascia che i clienti cambino lingua "
"all'istante."

#: .\core\views.py:363
msgid "Better guest experience for tourists"
msgstr "Miglior esperienza per i turisti"

#: .\core\views.py:364
msgid "Fewer ordering mistakes"
msgstr "Meno errori negli ordini"

#: .\core\views.py:365
msgid "Higher conversion on the menu page"
msgstr "Conversioni più alte sulla pagina menu"

#: .\core\views.py:370 .\templates\partials\navbar.html:53
msgid "Online Ordering"
msgstr "Ordinazione online"

#: .\core\views.py:371
msgid "Take orders directly from the QR menu."
msgstr "Ricevi ordini direttamente dal menu QR."

#: .\core\views.py:372
msgid ""
"Guests browse, add to cart, and checkout from their phone with a smooth "
"mobile-first flow."
msgstr ""
"Gli ospiti sfogliano, aggiungono al carrello e pagano dal telefono con un "
"flusso mobile-first fluido."

#: .\core\views.py:375
msgid "Increase average order value"
msgstr "Aumenta il valore medio dell'ordine"

#: .\core\views.py:376
msgid "Reduce table waiting time"
msgstr "Riduci i tempi di attesa al tavolo"

#: .\core\views.py:377
msgid "Capture more takeaway orders"
msgstr "Cattura più ordini d'asporto"

#: .\core\views.py:382 .\templates\partials\navbar.html:54
msgid "PDF Export"
msgstr "Esportazione PDF"

#: .\core\views.py:383
msgid "Keep digital and printed menus in sync."
msgstr "Mantieni menu digitali e cartacei sincronizzati."

#: .\core\views.py:384
msgid ""
"Export your latest menu as PDF for table cards, flyers, and offline sharing."
msgstr ""
"Esporta l'ultimo menu in PDF per cartellini tavolo, flyer e condivisione "
"offline."

#: .\core\views.py:387
msgid "Ready-to-print output"
msgstr "Output pronto per la stampa"

#: .\core\views.py:388
msgid "Consistent branding across channels"
msgstr "Branding coerente su tutti i canali"

#: .\core\views.py:389
msgid "Simple backup of menu data"
msgstr "Backup semplice dei dati del menu"

#: .\core\views.py:394 .\templates\partials\navbar.html:55
msgid "Real-Time Updates"
msgstr "Aggiornamenti in tempo reale"

#: .\core\views.py:395
msgid "Update prices and stock instantly."
msgstr "Aggiorna prezzi e scorte all'istante."

#: .\core\views.py:396
msgid ""
"Publish menu changes live in seconds so guests always see accurate "
"information."
msgstr ""
"Pubblica le modifiche al menu in pochi secondi affinché gli ospiti vedano "
"sempre info accurate."

#: .\core\views.py:399
msgid "No stale menu data"
msgstr "Nessun dato menu obsoleto"

#: .\core\views.py:400
msgid "Fewer customer complaints"
msgstr "Meno reclami dei clienti"

#: .\core\views.py:401
msgid "Faster reaction to peak-hour demand"
msgstr "Risposta più rapida alla domanda nelle ore di punta"

#: .\core\views.py:406 .\templates\partials\navbar.html:56
msgid "Secure Payment Processing"
msgstr "Elaborazione pagamenti sicura"

#: .\core\views.py:407
msgid "Accept payments safely and confidently."
msgstr "Accetta pagamenti in sicurezza e con fiducia."

#: .\core\views.py:408
msgid ""
"Support secure online checkout with trusted gateways and encrypted "
"transaction flow."
msgstr ""
"Supporta checkout online sicuri con gateway affidabili e flusso di "
"transazione cifrato."

#: .\core\views.py:411
msgid "Safer transactions"
msgstr "Transazioni più sicure"

#: .\core\views.py:412
msgid "More trust from customers"
msgstr "Maggiore fiducia dei clienti"

#: .\core\views.py:413
msgid "Higher checkout completion"
msgstr "Maggior tasso di completamento checkout"

#: .\core\views.py:418 .\templates\partials\navbar.html:57
msgid "Smart Order Management"
msgstr "Gestione intelligente degli ordini"

#: .\core\views.py:419
msgid "Track every order in one clean queue."
msgstr "Traccia ogni ordine in una coda pulita."

#: .\core\views.py:420
msgid ""
"Filter by status, prioritize prep, and keep front-of-house and kitchen fully"
" synchronized."
msgstr ""
"Filtra per stato, prioritizza la preparazione e mantieni sala e cucina "
"sincronizzate."

#: .\core\views.py:423
msgid "Clear workflow for staff"
msgstr "Flusso di lavoro chiaro per lo staff"

#: .\core\views.py:424
msgid "Faster fulfillment"
msgstr "Evasione più rapida"

#: .\core\views.py:425
msgid "Improved customer satisfaction"
msgstr "Maggiore soddisfazione del cliente"

